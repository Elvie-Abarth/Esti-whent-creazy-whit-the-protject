flowchart TB
    HOME["/ Index"]

    subgraph PUBLIC["Public - on the explicit allow-list in Program.cs (deny by default)"]
        MAR["/Marsvin<br/>photo animals first"]
        MDET["/Marsvin/Details/{id}"]
        TIL["/Tilbehor<br/>search, category / price / brand filters,<br/>sort, 24 per page"]
        MAE["/Maerker"]
        PAS["/Pasningsguide"]
        PASH["/PasningsguideHurtig"]
        FOD["/Foderliste"]
        FAQ["/Faq"]
        OM["/OmOs"]
        KON["/Kontakt<br/>contact form, rate limited"]
        STO["/Stoet<br/>donations (demo), rate limited,<br/>thank-you email if an address is given"]
        BET["/BetalingOgLevering"]
        PRI["/Privatliv"]
        CHAT["/Chat<br/>POST only - behind the Pip bubble,<br/>rate limited 20/min"]
        ERR["/Error?code= and /ServerError"]
    end

    subgraph PDF["PDF downloads - QuestPDF, public"]
        FPDF["/Foderliste/Pdf"]
        PPDF["/PasningsguideHurtig/Pdf"]
    end

    subgraph AUTHFLOW["Anonymous - sign-in flow, rate limited"]
        REG["/Account/Register"]
        LOG["/Account/Login"]
        CHK["/Account/CheckEmail"]
        CONF["/Account/ConfirmLogin?token="]
        TOTP["/Account/VerifyTotp?token="]
        FOR["/Account/ForgotPassword"]
        RES["/Account/ResetPassword?token="]
        OUT["/Account/Logout (POST)"]
        DEN["/Account/AccessDenied"]
    end

    subgraph SHOPPING["Public, but not for staff accounts - guest or Customer"]
        CART["/Cart<br/>guest: session cart, Customer: database cart"]
        PAY["/Cart/Payment<br/>details, delivery + carrier, payment"]
        OCON["/Cart/Confirmation/{orderId}<br/>own order only - status, cancel"]
    end

    subgraph ANYUSER["Signed in - any role"]
        PRO["/Account/Profile<br/>details, password, TOTP, log out everywhere,<br/>staff: shifts and time off,<br/>Customer: orders, cancel, delete account"]
    end

    subgraph STAFF["[Authorize(Roles=Admin,Employee)] - admin shell: left sidebar on every page"]
        AIDX["/Admin - dashboard (Oversigt)<br/>sidebar groups: Dashboard / Operations / Shop / Administration"]
        ASTO["/Admin/Stock"]
        AORD["/Admin/Orders<br/>status + tracking number"]
        AMSG["/Admin/Messages"]
        ADON["/Admin/Donations"]
        ASCH["/Admin/Schedule<br/>assign and decide: Admin only, inside the handlers"]
        ASHP["/Admin/Shop - shop overview<br/>(kept, reachable by URL; the sidebar links pages directly)"]
    end

    subgraph ADMINONLY["[Authorize(Roles=Admin)]"]
        APRO["/Admin/Products + Edit"]
        AANI["/Admin/Animals + Edit"]
        APRM["/Admin/Promotions + Edit"]
        AUSR["/Admin/Users"]
        AEXP["/Admin/Users/Export/{id}"]
        ALOG["/Admin/AuditLog"]
        ASEC["/Admin/SecurityLog<br/>recorded attack attempts, severity-coded"]
        AADM["/Admin/Administration - admin overview<br/>(kept, reachable by URL)"]
    end

    subgraph API["JSON API - JWT bearer, not pages (no HTML, bare 401 / 403 / 404)"]
        ATOK["POST /api/auth/token<br/>needs the website login cookie<br/>returns a 15 min token"]
        AME["/api/me, /api/orders<br/>any role - own data only"]
        AAORD["/api/admin/orders<br/>Admin and Employee"]
        AAUSR["/api/admin/users<br/>Admin only"]
    end

    HOME --> MAR
    HOME --> TIL
    HOME --> PAS
    HOME --> FAQ
    HOME --> OM
    HOME --> KON
    HOME --> STO
    MAR --> MDET
    MAE -->|brand filter| TIL
    PAS --> PASH
    PASH --> PPDF
    FOD --> FPDF
    HOME -.->|chat bubble on every public page| CHAT
    MDET -->|add to cart| CART
    TIL -->|add to cart, then ask: cart or keep shopping| CART
    CART --> PAY
    PAY -->|guest or Customer| OCON
    PAY -.-> BET
    PAY -.->|guest may create an account instead| REG

    LOG -->|password ok, no 2FA| CHK
    CHK -->|emailed link| CONF
    LOG -->|password ok, TOTP enrolled| TOTP
    CONF -->|signs in, merges guest cart,<br/>claims the guest order| PRO
    TOTP -->|signs in, merges guest cart| PRO
    LOG --> REG
    REG --> CHK
    LOG --> FOR
    FOR -->|emailed link| RES
    RES --> LOG
    PRO --> OUT
    PRO -.->|"signed in, ask for a token"| ATOK
    ATOK -->|Authorization: Bearer| AME
    ATOK -->|Staff token| AAORD
    ATOK -->|Admin token| AAUSR
    PRO -->|log out everywhere| LOG

    %% Both login-completion flows land a staff account on the dashboard
    %% (a Customer lands on the storefront home instead).
    CONF -.->|Role = staff -> dashboard| AIDX
    TOTP -.->|Role = staff -> dashboard| AIDX

    %% The admin shell's left sidebar (shown on every /Admin page) links the
    %% dashboard straight to each admin page; every page also has one
    %% Back to dashboard button. The two overview pages are kept but no longer
    %% part of the primary navigation.
    AIDX -->|sidebar| ASTO
    AIDX -->|sidebar| AORD
    AIDX -->|sidebar| AMSG
    AIDX -->|sidebar| ADON
    AIDX -->|sidebar| ASCH
    AIDX -->|sidebar: Admin only| APRO
    AIDX -->|sidebar: Admin only| AANI
    AIDX -->|sidebar: Admin only| APRM
    AIDX -->|sidebar: Admin only| AUSR
    AIDX -->|sidebar: Admin only| ALOG
    AIDX -->|sidebar: Admin only| ASEC
    AIDX -.->|kept, by URL| ASHP
    AIDX -.->|kept, by URL| AADM
    AUSR --> AEXP

    ANYUSER -.->|not signed in, idle 30 min,<br/>8 h old, or password changed| LOG
    ADMINONLY -.->|Employee| DEN
    STAFF -.->|Customer| DEN
    ERR -.->|404, expired form 400, 429, 403| HOME
