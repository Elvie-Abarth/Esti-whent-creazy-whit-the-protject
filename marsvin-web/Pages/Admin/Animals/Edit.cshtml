@page "{id:int}"
@model MarsvinWebExample.Pages.Admin.Animals.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Nyt marsvin" : "Redigér marsvin";
    ViewData["TitleEn"] = Model.IsNew ? "New guinea pig" : "Edit guinea pig";
}

<div class="wrap section auth-page">
    <div class="section-head">
        <div>
            <h2 data-en="@(Model.IsNew ? "New guinea pig" : "Edit guinea pig")">@(Model.IsNew ? "Nyt marsvin" : "Redigér marsvin")</h2>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>

        <label><span data-en="Name">Navn</span><input asp-for="Input.Name" /></label>
        <label><span data-en="Description (Danish)">Beskrivelse (dansk)</span><input asp-for="Input.Description" /></label>
        <label><span>Description (English)</span><input asp-for="Input.DescriptionEn" /></label>
        <label><span data-en="Breed (Danish)">Race (dansk)</span><input asp-for="Input.Breed" /></label>
        <label><span>Breed (English)</span><input asp-for="Input.BreedEn" /></label>
        <label>
            <span data-en="Sex">Køn</span>
            <select asp-for="Input.Sex" asp-items="Html.GetEnumSelectList<Sex>()"></select>
        </label>
        <label><span data-en="Date of birth">Fødselsdato</span><input asp-for="Input.DateOfBirth" type="date" /></label>
        <label><span data-en="Colour (Danish)">Farve (dansk)</span><input asp-for="Input.Colour" /></label>
        <label><span>Colour (English)</span><input asp-for="Input.ColourEn" /></label>
        <label><span data-en="Coat colour 1 (hex)">Pelsfarve 1 (hex)</span><input asp-for="Input.CoatPrimary" type="color" /></label>
        <label><span data-en="Coat colour 2 (hex)">Pelsfarve 2 (hex)</span><input asp-for="Input.CoatSecondary" type="color" /></label>
        <label>
            <span data-en="Status">Status</span>
            <select asp-for="Input.Status" asp-items="Html.GetEnumSelectList<AnimalStatus>()"></select>
        </label>
        <label>
            <span data-en="Lives with (optional)">Bor sammen med (valgfri)</span>
            <select asp-for="Input.BondedWithId">
                <option value="">—</option>
                @foreach (var other in Model.OtherAnimals)
                {
                    <option value="@other.ProductId">@other.Name</option>
                }
            </select>
        </label>
        <label><span data-en="Personality (Danish)">Personlighed (dansk)</span><input asp-for="Input.Personality" /></label>
        <label><span>Personality (English)</span><input asp-for="Input.PersonalityEn" /></label>
        <label><span data-en="Upload photo (optional)">Upload foto (valgfri)</span><input asp-for="PhotoFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif" /></label>
        @if (!string.IsNullOrEmpty(Model.Input.PhotoUrl))
        {
            <img src="@Model.Input.PhotoUrl" alt="" style="max-width:160px;border-radius:8px;display:block;margin:4px 0 12px;" />
        }
        <label><span data-en="...or photo URL (optional - shows a drawing if empty)">...eller foto-URL (valgfri - viser tegning hvis tom)</span><input asp-for="Input.PhotoUrl" /></label>
        <label><span data-en="Price (kr.)">Pris (kr.)</span><input asp-for="Input.Price" type="number" step="1" /></label>

        <button type="submit" class="btn" data-en="Save">Gem</button>
        <a class="btn btn--quiet" asp-page="/Admin/Animals/Index" data-en="Cancel">Annullér</a>
    </form>
</div>
