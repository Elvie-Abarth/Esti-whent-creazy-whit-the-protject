@page "{id:int}"
@model MarsvinWebExample.Pages.Admin.Promotions.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Ny kampagne" : "Redigér kampagne";
    ViewData["TitleEn"] = Model.IsNew ? "New promotion" : "Edit promotion";
}

<div class="wrap section auth-page">
    <div class="section-head">
        <div>
            <h2 data-en="@(Model.IsNew ? "New promotion" : "Edit promotion")">@(Model.IsNew ? "Ny kampagne" : "Redigér kampagne")</h2>
        </div>
    </div>

    <form method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>

        <label><span data-en="Title">Titel</span><input asp-for="Input.Title" /></label>
        <label><span data-en="Description">Beskrivelse</span><input asp-for="Input.Description" /></label>
        <label><span data-en="Discount (%)">Rabat (%)</span><input asp-for="Input.DiscountPercent" type="number" min="1" max="100" /></label>
        <label>
            <span data-en="Applies to product (optional - empty = whole shop)">Gælder for produkt (valgfri - tom = hele butikken)</span>
            <select asp-for="Input.ProductId">
                <option value="">—</option>
                @foreach (var product in Model.Products)
                {
                    <option value="@product.ProductId">@product.Name</option>
                }
            </select>
        </label>
        <label><span data-en="Start date">Startdato</span><input asp-for="Input.StartDate" type="date" /></label>
        <label><span data-en="End date">Slutdato</span><input asp-for="Input.EndDate" type="date" /></label>
        <label class="checkbox-label">
            <input asp-for="Input.IsActive" type="checkbox" />
            <span data-en="Active">Aktiv</span>
        </label>

        <button type="submit" class="btn" data-en="Save">Gem</button>
        <a class="btn btn--quiet" asp-page="/Admin/Promotions/Index" data-en="Cancel">Annullér</a>
    </form>
</div>
