@page
@model MarsvinWebExample.Pages.Admin.Schedule.IndexModel
@{
    ViewData["Title"] = "Vagtplan";
    ViewData["TitleEn"] = "Work schedule";
    var isAdmin = User.IsInRole("Admin");
}

<div class="wrap section">
    <div class="section-head">
        <div>
            <h2 data-en="Work schedule">Vagtplan</h2>
            @if (isAdmin)
            {
                <p data-en="Every staff member's shifts. Assign a new one below.">Alle medarbejderes vagter. Tilføj en ny nedenfor.</p>
            }
            else
            {
                <p data-en="Your own upcoming shifts.">Dine egne kommende vagter.</p>
            }
        </div>
    </div>
    <div class="actions">
        <a class="btn btn--quiet" asp-page="/Admin/Index" data-en="Back to staff area">Til personalesiden</a>
    </div>
</div>

@if (isAdmin)
{
    <section class="section section--paper">
        <div class="wrap">
            <div class="section-head">
                <div>
                    <h2 data-en="Day-off requests awaiting a decision">Ferieanmodninger der afventer</h2>
                </div>
            </div>
            @if (Model.PendingRequests.Count == 0)
            {
                <p data-en="No pending requests.">Ingen afventende anmodninger.</p>
            }
            else
            {
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th data-en="Staff">Medarbejder</th>
                            <th data-en="Period">Periode</th>
                            <th data-en="Reason">Begrundelse</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model.PendingRequests)
                        {
                            <tr>
                                <td>@request.StaffName</td>
                                <td>@request.StartDate.ToString("d MMM") – @request.EndDate.ToString("d MMM yyyy")</td>
                                <td>@request.Reason</td>
                                <td>
                                    <form method="post" asp-page-handler="DecideRequest" class="inline-form">
                                        <input type="hidden" name="requestId" value="@request.RequestId" />
                                        <input type="hidden" name="approve" value="true" />
                                        <button type="submit" class="btn btn--quiet" data-en="Approve">Godkend</button>
                                    </form>
                                    <form method="post" asp-page-handler="DecideRequest" class="inline-form">
                                        <input type="hidden" name="requestId" value="@request.RequestId" />
                                        <input type="hidden" name="approve" value="false" />
                                        <button type="submit" class="btn btn--quiet" data-en="Deny">Afvis</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>
}

<section class="section">
    <div class="wrap">
        <div class="section-head">
            <div>
                <h2 data-en="Shifts">Vagter</h2>
            </div>
        </div>
        @if (Model.Shifts.Count == 0)
        {
            <p data-en="No shifts yet.">Ingen vagter endnu.</p>
        }
        else
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        @if (isAdmin)
                        {
                            <th data-en="Staff">Medarbejder</th>
                        }
                        <th data-en="Date">Dato</th>
                        <th data-en="Time">Tidspunkt</th>
                        <th data-en="Note">Note</th>
                        @if (isAdmin)
                        {
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shift in Model.Shifts)
                    {
                        <tr>
                            @if (isAdmin)
                            {
                                <td>@shift.StaffName</td>
                            }
                            <td>@shift.StartAt.ToString("d MMM yyyy")</td>
                            <td>@shift.StartAt.ToString("HH:mm")–@shift.EndAt.ToString("HH:mm")</td>
                            <td>@shift.Note</td>
                            @if (isAdmin)
                            {
                                <td>
                                    <form method="post" asp-page-handler="Delete" class="inline-form"
                                          onsubmit="return confirm('Slet denne vagt?');">
                                        <input type="hidden" name="shiftId" value="@shift.ShiftId" />
                                        <button type="submit" class="btn btn--quiet" data-en="Delete">Slet</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>

@if (isAdmin)
{
    <section class="section section--paper">
        <div class="wrap auth-page">
            <div class="section-head">
                <div>
                    <h2 data-en="Assign a shift">Tilføj en vagt</h2>
                </div>
            </div>
            <form method="post" asp-page-handler="Create" class="auth-form">
                <label>
                    <span data-en="Staff member">Medarbejder</span>
                    <select name="userId" required>
                        <option value="" selected disabled data-en="Choose a staff member">Vælg en medarbejder</option>
                        @foreach (var staff in Model.StaffMembers)
                        {
                            <option value="@staff.UserId">@staff.DisplayName (@staff.Role)</option>
                        }
                    </select>
                </label>
                <label>
                    <span data-en="Date">Dato</span>
                    <input type="date" name="date" required />
                </label>
                <label>
                    <span data-en="Start time">Starttidspunkt</span>
                    <input type="time" name="startTime" required />
                </label>
                <label>
                    <span data-en="End time">Sluttidspunkt</span>
                    <input type="time" name="endTime" required />
                </label>
                <label>
                    <span data-en="Note (optional)">Note (valgfrit)</span>
                    <input type="text" name="note" maxlength="200" />
                </label>
                <button type="submit" class="btn" data-en="Add shift">Tilføj vagt</button>
            </form>
        </div>
    </section>
}
