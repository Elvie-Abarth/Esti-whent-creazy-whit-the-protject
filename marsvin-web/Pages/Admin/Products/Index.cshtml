@page
@model MarsvinWebExample.Pages.Admin.Products.IndexModel
@{
    ViewData["Title"] = "Tilbehør (admin)";
    ViewData["TitleEn"] = "Accessories (admin)";
}

<div class="wrap section">
    <div class="section-head">
        <div>
            <h2 data-en="Accessories">Tilbehør</h2>
        </div>
    </div>
    <div class="actions">
        <a class="btn btn--quiet" asp-page="/Admin/Index" data-en="Back to staff area">Til personalesiden</a>
        <a class="btn" asp-page="/Admin/Products/Edit" asp-route-id="0" data-en="Add new">Tilføj ny</a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th data-en="Name">Navn</th>
                <th data-en="Category">Kategori</th>
                <th data-en="Price">Pris</th>
                <th data-en="Stock">Lager</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.CategoryName</td>
                    <td>@item.Price.ToString("N0") kr.</td>
                    <td>@item.StockQuantity</td>
                    <td>
                        <a class="btn btn--quiet" asp-page="/Admin/Products/Edit" asp-route-id="@item.ProductId" data-en="Edit">Redigér</a>
                        <form method="post" asp-page-handler="Delete" class="inline-form" onsubmit="return confirm('Slet @item.Name?');">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button type="submit" class="btn btn--quiet" data-en="Delete">Slet</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
