@page "{id:int}"
@model MarsvinWebExample.Pages.Admin.Products.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Nyt tilbehør" : "Redigér tilbehør";
    ViewData["TitleEn"] = Model.IsNew ? "New accessory" : "Edit accessory";
}

<div class="wrap section auth-page">
    <div class="section-head">
        <div>
            <h2 data-en="@(Model.IsNew ? "New accessory" : "Edit accessory")">@(Model.IsNew ? "Nyt tilbehør" : "Redigér tilbehør")</h2>
        </div>
    </div>

    <form method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>

        <label>
            <span data-en="Name (Danish)">Navn (dansk)</span>
            <input asp-for="Input.Name" />
        </label>
        <label>
            <span>Name (English)</span>
            <input asp-for="Input.NameEn" />
        </label>
        <label>
            <span data-en="Description (Danish)">Beskrivelse (dansk)</span>
            <input asp-for="Input.Description" />
        </label>
        <label>
            <span>Description (English)</span>
            <input asp-for="Input.DescriptionEn" />
        </label>
        <label>
            <span>SKU</span>
            <input asp-for="Input.Sku" />
        </label>
        <label>
            <span data-en="Category">Kategori</span>
            <select asp-for="Input.Category" asp-items="Html.GetEnumSelectList<AccessoryCategory>()"></select>
        </label>
        <label>
            <span data-en="Price (kr.)">Pris (kr.)</span>
            <input asp-for="Input.Price" type="number" step="1" />
        </label>
        <label>
            <span data-en="Stock quantity">Lagerantal</span>
            <input asp-for="Input.StockQuantity" type="number" />
        </label>
        <label>
            <span data-en="Unit (e.g. bag, pcs)">Enhed (fx pose, stk)</span>
            <input asp-for="Input.Unit" />
        </label>
        <label>
            <span data-en="Photo URL (optional - shows a category icon if empty)">Foto-URL (valgfri - viser et kategori-ikon hvis tom)</span>
            <input asp-for="Input.PhotoUrl" />
        </label>

        <button type="submit" class="btn" data-en="Save">Gem</button>
        <a class="btn btn--quiet" asp-page="/Admin/Products/Index" data-en="Cancel">Annullér</a>
    </form>
</div>
