@page
@model MarsvinWebExample.Pages.Admin.Administration.IndexModel
@{
    ViewData["Title"] = "Administration";
    ViewData["TitleEn"] = "Administration";
}

<div class="wrap section">
    <div class="section-head">
        <div>
            <h2 data-en="Administration">Administration</h2>
            <p data-en="Accounts, the activity log and the security log - admin oversight, kept separate from the day-to-day staff tasks.">
                Konti, logbogen og sikkerhedsloggen - administrativt overblik, holdt adskilt fra den daglige drift.
            </p>
        </div>
    </div>

    <ul class="admin-links">
        <li>
            <a asp-page="/Admin/Users/Index">
                <h3 data-en="Accounts">Konti</h3>
                <p data-en="Manage customer, employee, and admin accounts.">Administrér kunde-, medarbejder- og admin-konti.</p>
            </a>
        </li>
        <li>
            <a asp-page="/Admin/AuditLog/Index">
                <h3 data-en="Activity log">Logbog</h3>
                <p data-en="Who changed what, and when.">Hvem ændrede hvad, og hvornår.</p>
            </a>
        </li>
        <li>
            <a asp-page="/Admin/SecurityLog/Index">
                <h3 data-en="Security log">Sikkerhedslog
                    @if (Model.SecurityEventsLast24Hours > 0)
                    {
                        <span class="status status--denied" data-en="@($"{Model.SecurityEventsLast24Hours} in 24h")">@Model.SecurityEventsLast24Hours i 24t</span>
                    }
                </h3>
                <p data-en="Recorded attack attempts (failed logins, wrong-role requests, rate limits).">Registrerede angrebsforsøg (mislykkede logins, forkert rolle, for mange forsøg).</p>
            </a>
        </li>
    </ul>

    <div class="actions">
        <a class="btn btn--quiet" asp-page="/Admin/Index" data-en="Back to dashboard">Til oversigten</a>
    </div>
</div>
