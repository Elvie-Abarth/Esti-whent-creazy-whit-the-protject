@page
@using MarsvinWebExample.Models
@model MarsvinWebExample.Pages.Admin.Orders.IndexModel
@{
    ViewData["Title"] = "Ordrer (admin)";
    ViewData["TitleEn"] = "Orders (admin)";
}

<div class="wrap section">
    <div class="section-head">
        <div>
            <h2 data-en="Orders">Ordrer</h2>
            <p data-en="Every order placed in the shop, most recent first.">Alle ordrer afgivet i butikken, det seneste øverst.</p>
        </div>
    </div>
    <div class="actions">
        <a class="btn btn--quiet" asp-page="/Admin/Index" data-en="Back to staff area">Til personalesiden</a>
    </div>

    @if (Model.Items.Count == 0)
    {
        <p data-en="No orders yet.">Ingen ordrer endnu.</p>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th data-en="Order">Ordre</th>
                    <th data-en="Date">Dato</th>
                    <th data-en="Customer">Kunde</th>
                    <th data-en="Items">Varer</th>
                    <th data-en="Total">I alt</th>
                    <th data-en="Delivery">Levering</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Items)
                {
                    <tr>
                        <td>#@order.OrderId</td>
                        <td>@order.CreatedAt.ToString("d MMM yyyy HH:mm")</td>
                        <td>
                            @if (order.BuyerDisplayName is not null)
                            {
                                @order.BuyerDisplayName <br /><span class="cavy-meta">@order.BuyerEmail</span>
                            }
                            else if (order.GuestName is not null)
                            {
                                @order.GuestName <span class="cavy-meta" data-en="(guest)">(gæst)</span><br /><span class="cavy-meta">@order.GuestEmail</span>
                            }
                            else
                            {
                                <span class="cavy-meta" data-en="Account deleted">Konto slettet</span>
                            }
                            @if (order.CompanyName is not null)
                            {
                                <br /><span class="cavy-meta">@order.CompanyName, CVR @order.CompanyCvr</span>
                            }
                            @if (order.ContactPhone is not null)
                            {
                                <br /><span class="cavy-meta" data-en="@($"Phone: {order.ContactPhone}")">Tlf.: @order.ContactPhone</span>
                            }
                            @if (order.AgeConfirmed)
                            {
                                <br /><span class="cavy-meta" data-en="Confirmed 16 or older">Har bekræftet at være fyldt 16 år</span>
                            }
                        </td>
                        <td>@string.Join(", ", order.Items.Select(i => $"{i.ProductName} x{i.Quantity}"))</td>
                        <td>@order.TotalPrice.ToString("N0") kr.</td>
                        <td>
                            @if (order.DeliveryMethod == DeliveryMethod.Shipping)
                            {
                                <span data-en="@($"Shipping: {order.ShippingAddress} ({order.ShippingCarrier?.DisplayName(english: true)})")">Fragt: @order.ShippingAddress (@order.ShippingCarrier?.DisplayName())</span>
                                @if (order.ShippingWeightGrams is int grams && order.ParcelCount is int parcels)
                                {
                                    <br /><span class="cavy-meta" data-en="@($"{ShippingCalculator.FormatWeight(grams, english: true)}, {(parcels == 1 ? "1 parcel" : $"{parcels} parcels")}, shipping {order.ShippingCost:N0} kr.")">@ShippingCalculator.FormatWeight(grams), @(parcels == 1 ? "1 pakke" : $"{parcels} pakker"), fragt @order.ShippingCost.ToString("N0") kr.</span>
                                }
                                @if (order.ExpectedDelivery is var (earliest, latest))
                                {
                                    <br /><span class="cavy-meta" data-en="@($"Promised: {ShippingCalculator.FormatWindow(earliest, latest)}")">Lovet: @ShippingCalculator.FormatWindow(earliest, latest)</span>
                                }
                            }
                            else
                            {
                                <span data-en="Pickup">Afhentning</span>
                            }
                        </td>
                        <td>
                            @if (order.Status == OrderStatus.Cancelled)
                            {
                                @* Final: its items are back in stock, so it can't be reopened. *@
                                <strong data-en="Cancelled">Annulleret</strong>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="SetStatus" class="order-status-form">
                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                    <select name="status" aria-label="Status">
                                        @foreach (var status in Enum.GetValues<OrderStatus>())
                                        {
                                            <option value="@status" selected="@(status == order.Status)" data-en="@status.DisplayName(order.DeliveryMethod, english: true)">@status.DisplayName(order.DeliveryMethod)</option>
                                        }
                                    </select>
                                    @if (order.DeliveryMethod == DeliveryMethod.Shipping)
                                    {
                                        <input type="text" name="trackingNumber" value="@order.TrackingNumber" maxlength="50"
                                               placeholder="Track & trace" aria-label="Track & trace-nummer" data-en-aria-label="Track & trace number" />
                                    }
                                    <button type="submit" class="btn btn--quiet" data-en="Save">Gem</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
