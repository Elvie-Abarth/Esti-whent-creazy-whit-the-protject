@page
@model MarsvinWebExample.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Personale";
    ViewData["TitleEn"] = "Staff";
}

<div class="wrap section">
    <div class="section-head">
        <div>
            <h2 data-en="Staff area">Personale</h2>
            <p data-en="@($"Signed in as {User.Identity!.Name} ({(User.IsInRole("Admin") ? "Admin" : "Employee")}).")">
                Logget ind som @User.Identity!.Name (@(User.IsInRole("Admin") ? "Admin" : "Medarbejder")).
            </p>
        </div>
    </div>

    <ul class="admin-links">
        <li>
            <a asp-page="/Admin/Schedule/Index">
                <h3 data-en="Work schedule">Vagtplan</h3>
                <p data-en="See who's working when, or assign a shift.">Se hvem der arbejder hvornår, eller tilføj en vagt.</p>
            </a>
        </li>
        <li>
            <a asp-page="/Admin/Messages/Index">
                <h3 data-en="Messages">Beskeder</h3>
                <p data-en="What customers have written through the contact form.">Hvad kunderne har skrevet via kontaktformularen.</p>
            </a>
        </li>
        <li>
            <a asp-page="/Admin/Donations/Index">
                <h3 data-en="Donations">Donationer</h3>
                <p data-en="Amounts and items given towards rehomed guinea pigs.">Beløb og varer givet til genplacerede marsvin.</p>
            </a>
        </li>
        @if (User.IsInRole("Admin"))
        {
            <li>
                <a asp-page="/Admin/Users/Index">
                    <h3 data-en="Accounts">Konti</h3>
                    <p data-en="Manage customer, employee, and admin accounts.">Administrér kunde-, medarbejder- og admin-konti.</p>
                </a>
            </li>
            <li>
                <a asp-page="/Admin/AuditLog/Index">
                    <h3 data-en="Activity log">Logbog</h3>
                    <p data-en="Who changed what, and when.">Hvem ændrede hvad, og hvornår.</p>
                </a>
            </li>
        }
    </ul>
</div>
