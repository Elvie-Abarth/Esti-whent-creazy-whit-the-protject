@page
@model MarsvinWebExample.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Oversigt";
    ViewData["TitleEn"] = "Dashboard";
    var isAdmin = User.IsInRole("Admin");
}

<div class="wrap section">
    <div class="section-head">
        <div>
            <h2 data-en="Dashboard">Oversigt</h2>
            <p data-en="@($"Signed in as {User.Identity!.Name} ({(isAdmin ? "Admin" : "Employee")}). Use the menu on the left to get around.")">
                Logget ind som @User.Identity!.Name (@(isAdmin ? "Admin" : "Medarbejder")). Brug menuen til venstre for at navigere.
            </p>
        </div>
    </div>

    @* Shortcuts to the day-to-day tasks. The full set lives in the sidebar;
       these are just the ones staff reach for most. *@
    <ul class="admin-links">
        <li>
            <a asp-page="/Admin/Orders/Index">
                <h3 data-en="Orders">Ordrer</h3>
                <p data-en="Every order placed in the shop.">Alle ordrer afgivet i butikken.</p>
            </a>
        </li>
        <li>
            <a asp-page="/Admin/Messages/Index">
                <h3 data-en="Messages">Beskeder</h3>
                <p data-en="What customers have written through the contact form.">Hvad kunderne har skrevet via kontaktformularen.</p>
            </a>
        </li>
        <li>
            <a asp-page="/Admin/Schedule/Index">
                <h3 data-en="Work schedule">Vagtplan</h3>
                <p data-en="See who's working when, or assign a shift.">Se hvem der arbejder hvornår, eller tilføj en vagt.</p>
            </a>
        </li>
        <li>
            <a asp-page="/Admin/Stock/Index">
                <h3 data-en="Stock &amp; status">Lager &amp; status</h3>
                <p data-en="Update stock counts and mark animals reserved / not for sale.">Opdatér lagerantal og markér dyr reserveret / ikke til salg.</p>
            </a>
        </li>
        @if (isAdmin)
        {
            <li>
                <a asp-page="/Admin/SecurityLog/Index">
                    <h3 data-en="Security log">Sikkerhedslog
                        @if (Model.SecurityEventsLast24Hours > 0)
                        {
                            <span class="status status--denied" data-en="@($"{Model.SecurityEventsLast24Hours} in 24h")">@Model.SecurityEventsLast24Hours på 24t</span>
                        }
                    </h3>
                    <p data-en="Recorded attack attempts - failed logins, wrong-role requests, rate limits.">Registrerede angrebsforsøg - mislykkede logins, forkert-rolle-forespørgsler, rate limits.</p>
                </a>
            </li>
        }
    </ul>
</div>
