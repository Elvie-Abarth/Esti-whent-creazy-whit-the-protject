@page
@{
    ViewData["Title"] = "Kontakt";
}

<div class="wrap section guide-intro">
    <div class="section-head">
        <h1 data-en="Contact">Kontakt</h1>
        <p data-en="Questions about a guinea pig, an order, or the cage you're planning — reach us however suits you.">
            Spørgsmål om et marsvin, en ordre, eller buret du planlægger —
            skriv eller ring, alt efter hvad der passer dig.
        </p>
    </div>
</div>

<section class="section">
    <div class="wrap guide-article">
        <article>
            <h2 data-en="Shop">Butikken</h2>
            <ul class="facts">
                <li><span data-en="Address">Adresse</span><span>Havnegade 12, 6700 Esbjerg</span></li>
                <li><span data-en="Opening hours">Åbningstider</span><span data-en="Thursday and Friday 14–18, Saturday 10–14">Torsdag og fredag 14–18, lørdag 10–14</span></li>
                <li><span>E-mail</span><span><a href="mailto:kontakt@marsvin.dk">kontakt@marsvin.dk</a></span></li>
                <li><span data-en="Phone">Telefon</span><span><a href="tel:+4570123456">70 12 34 56</a></span></li>
            </ul>
        </article>

        <div class="callout">
            <h2 data-en="Demo project">Demoprojekt</h2>
            <p data-en="This address, email and phone number are placeholders for an example webshop, not a real business — see Om os for the full note.">
                Denne adresse, e-mail og dette telefonnummer er pladsholdere
                til en eksempelwebshop, ikke en rigtig forretning — se Om os for hele bemærkningen.
            </p>
        </div>
    </div>
</section>
