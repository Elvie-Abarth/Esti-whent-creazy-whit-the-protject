@using System.Security.Claims
@inject MarsvinWebExample.Data.ICartStore CartStoreForNav
<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-en="@(ViewData["TitleEn"] ?? ViewData["Title"]) - Marsvin">@ViewData["Title"] - Marsvin</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Karla:wght@400;500;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<header class="site-header">
    <div class="wrap">
        <a class="brand" asp-page="/Index">
            <svg viewBox="0 0 240 160" aria-hidden="true">
                <ellipse cx="132" cy="92" rx="96" ry="50" fill="#B5643C" />
                <ellipse cx="58" cy="80" rx="46" ry="41" fill="#B5643C" />
                <ellipse cx="52" cy="44" rx="17" ry="12" transform="rotate(-28 52 44)" fill="#F3EAD8" />
                <circle cx="34" cy="74" r="6.5" fill="#23301F" />
            </svg>
            Marsvin
        </a>

        <nav class="site-nav" aria-label="Hovedmenu" data-en-aria-label="Main menu">
            <a asp-page="/Marsvin/Index" data-en="Guinea pigs">Marsvinene</a>
            <a asp-page="/Tilbehor/Index" data-en="Accessories">Tilbehør</a>
            <a asp-page="/Pasningsguide" data-en="Care guide">Pasningsguide</a>
            <details class="nav-dropdown">
                <summary data-en="About the shop">Om butikken</summary>
                <div class="nav-dropdown-menu">
                    <a asp-page="/OmOs" data-en="About us">Om os</a>
                    <a asp-page="/Kontakt" data-en="Contact">Kontakt</a>
                    <a asp-page="/Faq" data-en="FAQ">Ofte stillede spørgsmål</a>
                    <a asp-page="/Maerker" data-en="Brands">Mærker</a>
                    <a asp-page="/BetalingOgLevering" data-en="Payment &amp; delivery">Betaling &amp; levering</a>
                    <a asp-page="/Stoet" data-en="Support guinea pigs in need">Støt marsvin i nød</a>
                    <a asp-page="/Privatliv" data-en="Privacy policy">Privatlivspolitik</a>
                </div>
            </details>
        </nav>

        <nav class="account-nav" aria-label="Konto" data-en-aria-label="Account">
            @if (User.Identity?.IsAuthenticated == true)
            {
                if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                {
                    <a asp-page="/Admin/Index" data-en="Staff">Personale</a>
                    <a asp-page="/Admin/Shop/Index" data-en="Shop management">Butiksstyring</a>
                }
                else
                {
                    var userId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);
                    var cartCount = CartStoreForNav.GetLines(userId).Sum(l => l.Quantity);
                    <a asp-page="/Cart/Index" data-en="@($"Cart ({cartCount})")">Kurv (@cartCount)</a>
                }
                <a class="account-name" asp-page="/Account/Profile"
                   aria-label="Kontoindstillinger" data-en-aria-label="Account settings">@User.Identity!.Name</a>
                <form method="post" asp-page="/Account/Logout" class="logout-form">
                    <button type="submit" class="header-btn" data-en="Log out">Log ud</button>
                </form>
            }
            else
            {
                @* A guest can shop and check out too (see Cart/* having no
                   [Authorize]) - CartStoreForNav resolves to SessionCartStore
                   here, the same ICartStore every Cart/* page model gets, so
                   this reads whatever's actually in the guest's own cart. *@
                var cartCount = CartStoreForNav.GetLines(0).Sum(l => l.Quantity);
                <a asp-page="/Cart/Index" data-en="@($"Cart ({cartCount})")">Kurv (@cartCount)</a>
                <a class="header-btn" asp-page="/Account/Login" data-en="Log in">Log ind</a>
                <a class="header-btn" asp-page="/Account/Register" data-en="Sign up">Opret konto</a>
            }
        </nav>

        <button type="button" id="lang-toggle" class="header-btn lang-toggle" aria-label="Switch to English">EN</button>
    </div>
</header>

<main>
    @RenderBody()
</main>

@* Every ToastMessage/ErrorMessage in the app is [TempData], set right before
   a redirect - rendered once, here, instead of each page repeating its own
   "@if (Model.ErrorMessage...)" block in a different spot on the page. Both
   are packed as Bilingual (see Models/Bilingual.cs): C# code has no markup
   to attach a data-en attribute to, so the message travels through TempData
   as one encoded string and gets unpacked back into Da/En right here. *@
@if (TempData["ToastMessage"] is string toastMessageRaw)
{
    var toastMessage = Bilingual.Parse(toastMessageRaw);
    @if (TempData["AskWhereNext"] is true)
    {
        @* After "Læg i kurv" (see Cart/Index's OnPostAdd): stays until the
           buyer picks one. "Keep shopping" is just a link back to this same
           page - TempData is read-once, so it comes back without the box. *@
        <div class="toast toast--ask" role="alertdialog" aria-labelledby="cart-ask-title">
            <p id="cart-ask-title" data-en="@toastMessage.En">@toastMessage.Da</p>
            <div class="toast-actions">
                <a class="btn" asp-page="/Cart/Index" data-en="Go to cart">Gå til kurven</a>
                <a class="btn btn--quiet" href="@(Context.Request.Path + Context.Request.QueryString)" data-en="Keep shopping">Fortsæt med at handle</a>
            </div>
        </div>
    }
    else
    {
        <p class="toast" role="status" aria-live="polite" data-en="@toastMessage.En">@toastMessage.Da</p>
    }
}
@if (TempData["ErrorMessage"] is string errorToastMessageRaw)
{
    var errorToastMessage = Bilingual.Parse(errorToastMessageRaw);
    <p class="toast toast--error" role="alert" aria-live="assertive" data-en="@errorToastMessage.En">@errorToastMessage.Da</p>
}

<footer class="site-footer">
    <div class="wrap footer-grid">
        <div class="footer-brand">
            <a class="footer-logo" asp-page="/Index">
                <svg viewBox="0 0 240 160" aria-hidden="true">
                    <ellipse cx="132" cy="92" rx="96" ry="50" fill="#B5643C" />
                    <ellipse cx="58" cy="80" rx="46" ry="41" fill="#B5643C" />
                    <ellipse cx="52" cy="44" rx="17" ry="12" transform="rotate(-28 52 44)" fill="#F3EAD8" />
                    <circle cx="34" cy="74" r="6.5" fill="#23301F" />
                </svg>
                Marsvin
            </a>
            <p data-en="Guinea pigs in pairs, and everything they need - from a shop that would rather talk through the cage with you first.">
                Marsvin i par, og alt hvad de skal bruge - fra en butik, der hellere vil snakke buret igennem med dig først.
            </p>
        </div>

        <div class="footer-col">
            <h2 data-en="Visit the shop">Besøg butikken</h2>
            <address>
                <span data-en="Havnegade 12, 6700 Esbjerg">Havnegade 12, 6700 Esbjerg</span>
            </address>
            <dl class="footer-hours">
                <dt data-en="Thursday and Friday">Torsdag og fredag</dt>
                <dd>14–18</dd>
                <dt data-en="Saturday">Lørdag</dt>
                <dd>10–14</dd>
            </dl>
        </div>

        <nav class="footer-col" aria-label="Kundeservice" data-en-aria-label="Customer service">
            <h2 data-en="Customer service">Kundeservice</h2>
            <a asp-page="/Kontakt" data-en="Contact">Kontakt</a>
            <a asp-page="/Faq" data-en="FAQ">Ofte stillede spørgsmål</a>
            <a asp-page="/BetalingOgLevering" data-en="Payment &amp; delivery">Betaling &amp; levering</a>
            <a asp-page="/Privatliv" data-en="Privacy policy">Privatlivspolitik</a>
        </nav>

        <nav class="footer-col" aria-label="Om butikken" data-en-aria-label="About the shop">
            <h2 data-en="About the shop">Om butikken</h2>
            <a asp-page="/OmOs" data-en="About us">Om os</a>
            <a asp-page="/Maerker" data-en="Brands">Mærker</a>
            <a asp-page="/Pasningsguide" data-en="Care guide">Pasningsguide</a>
            <a asp-page="/Stoet" data-en="Support guinea pigs in need">Støt marsvin i nød</a>
        </nav>
    </div>

    @* The strolling mascot: centred, walking along the line above the bottom bar. *@
    <div class="wrap footer-mascot-row">
        <div class="footer-mascot-lane">
            <button type="button" class="footer-mascot-button"
                    aria-label="Klap marsvinet" data-en-aria-label="Pet the guinea pig">
                <div class="footer-mascot-walker">
                    <svg class="footer-mascot" viewBox="0 0 120 80" aria-hidden="true" focusable="false">
                        <g class="footer-mascot-body">
                            <ellipse cx="66" cy="46" rx="48" ry="25" fill="#F0E7D2" />
                            <ellipse cx="29" cy="40" rx="23" ry="20.5" fill="#F0E7D2" />
                            <ellipse cx="26" cy="22" rx="8.5" ry="6" transform="rotate(-28 26 22)" fill="#B83C6E" />
                            <circle cx="17" cy="37" r="3.2" fill="#23301F" />
                        </g>
                    </svg>
                    <span class="footer-mascot-heart" aria-hidden="true">&#9829;</span>
                </div>
            </button>
        </div>
    </div>

    <div class="wrap footer-copyright">
        <p>&copy; @DateTime.Now.Year Marsvin</p>
        <p data-en="Example shop built as inspiration for the Zealand project. Not a registered business.">Eksempelbutik bygget som inspiration til Zealand-projektet. Ikke en registreret virksomhed.</p>
    </div>
</footer>

@* The support chat bubble. Not for staff accounts (they have the admin
   pages), and hidden until chat.js runs - without JavaScript there's nothing
   it could do. The form's antiforgery token is what /Chat checks. *@
@if (!User.IsInRole("Admin") && !User.IsInRole("Employee"))
{
    <details class="chat" id="chat" hidden>
        @* data-en sits on the inner span, not the summary: the language toggle
           replaces an element's whole text, which would take the drawing with it. *@
        <summary class="chat-toggle" aria-label="Åbn chatten med Pip" data-en-aria-label="Open the chat with Pip">
            <svg class="chat-pig" viewBox="0 0 120 84" aria-hidden="true" focusable="false">
                <path d="M22 80 C16 60 24 30 50 20 C72 12 100 16 111 36 C119 50 118 68 115 81 Q109 71 104 81 Q98 71 92 81 Q86 71 80 81 Q74 71 68 81 Q62 71 56 81 Q50 71 44 81 Q38 71 32 81 Q27 73 22 80 Z" fill="#B19888" />
                <path d="M66 15 C86 14 104 22 111 36 C119 50 118 68 115 81 Q109 71 104 81 Q101 75 99 76 C103 56 96 30 66 15 Z" fill="#9F8475" />
                <g fill="none" stroke-linecap="round" opacity="0.55">
                    <path d="M62 17 C58 34 60 54 55 74" stroke="#8C7163" stroke-width="1.2" />
                    <path d="M74 16 C76 34 80 54 77 74" stroke="#C0794C" stroke-width="1.8" />
                    <path d="M86 19 C92 36 96 56 93 74" stroke="#E2D3C7" stroke-width="1.3" />
                    <path d="M97 25 C105 40 109 58 106 74" stroke="#C0794C" stroke-width="1.5" />
                    <path d="M52 21 C46 38 46 56 42 74" stroke="#E2D3C7" stroke-width="1.3" />
                </g>
                <ellipse cx="25" cy="55" rx="19" ry="18" fill="#D2BEB0" />
                <ellipse cx="40" cy="50" rx="6" ry="9" transform="rotate(14 40 50)" fill="#9A7F70" />
                <path d="M30 34 C36 16 60 12 74 20 C62 22 52 30 47 44 C45 38 42 36 40 38 C36 34 33 38 31 46 C28 40 24 42 21 48 C20 42 16 44 13 50 C13 42 20 34 30 34 Z" fill="#DDCDC1" />
                <g fill="none" stroke-linecap="round" opacity="0.6">
                    <path d="M34 30 C44 20 58 17 68 20" stroke="#C0794C" stroke-width="1.5" />
                    <path d="M26 37 C36 26 48 22 58 22" stroke="#B19888" stroke-width="1.2" />
                </g>
                <circle cx="20" cy="55" r="4.4" fill="#5B1626" />
                <circle cx="20" cy="55" r="3.2" fill="#8E2740" />
                <circle cx="21.3" cy="53.7" r="1.2" fill="#fff" />
                <ellipse cx="7" cy="60" rx="2.8" ry="2.1" fill="#E8A9B9" />
                <path d="M8 65 q4 3 8 0" fill="none" stroke="#8C7163" stroke-width="1.3" stroke-linecap="round" />
            </svg>
            <span class="chat-toggle-label" data-en="Ask Pip">Spørg Pip</span>
        </summary>
        <div class="chat-panel">
            <div class="chat-head">
                <svg class="chat-pig chat-pig--small" viewBox="0 0 120 84" aria-hidden="true" focusable="false">
                <path d="M22 80 C16 60 24 30 50 20 C72 12 100 16 111 36 C119 50 118 68 115 81 Q109 71 104 81 Q98 71 92 81 Q86 71 80 81 Q74 71 68 81 Q62 71 56 81 Q50 71 44 81 Q38 71 32 81 Q27 73 22 80 Z" fill="#B19888" />
                <path d="M66 15 C86 14 104 22 111 36 C119 50 118 68 115 81 Q109 71 104 81 Q101 75 99 76 C103 56 96 30 66 15 Z" fill="#9F8475" />
                <g fill="none" stroke-linecap="round" opacity="0.55">
                    <path d="M62 17 C58 34 60 54 55 74" stroke="#8C7163" stroke-width="1.2" />
                    <path d="M74 16 C76 34 80 54 77 74" stroke="#C0794C" stroke-width="1.8" />
                    <path d="M86 19 C92 36 96 56 93 74" stroke="#E2D3C7" stroke-width="1.3" />
                    <path d="M97 25 C105 40 109 58 106 74" stroke="#C0794C" stroke-width="1.5" />
                    <path d="M52 21 C46 38 46 56 42 74" stroke="#E2D3C7" stroke-width="1.3" />
                </g>
                <ellipse cx="25" cy="55" rx="19" ry="18" fill="#D2BEB0" />
                <ellipse cx="40" cy="50" rx="6" ry="9" transform="rotate(14 40 50)" fill="#9A7F70" />
                <path d="M30 34 C36 16 60 12 74 20 C62 22 52 30 47 44 C45 38 42 36 40 38 C36 34 33 38 31 46 C28 40 24 42 21 48 C20 42 16 44 13 50 C13 42 20 34 30 34 Z" fill="#DDCDC1" />
                <g fill="none" stroke-linecap="round" opacity="0.6">
                    <path d="M34 30 C44 20 58 17 68 20" stroke="#C0794C" stroke-width="1.5" />
                    <path d="M26 37 C36 26 48 22 58 22" stroke="#B19888" stroke-width="1.2" />
                </g>
                <circle cx="20" cy="55" r="4.4" fill="#5B1626" />
                <circle cx="20" cy="55" r="3.2" fill="#8E2740" />
                <circle cx="21.3" cy="53.7" r="1.2" fill="#fff" />
                <ellipse cx="7" cy="60" rx="2.8" ry="2.1" fill="#E8A9B9" />
                <path d="M8 65 q4 3 8 0" fill="none" stroke="#8C7163" stroke-width="1.3" stroke-linecap="round" />
            </svg>
                <div>
                    <strong>Pip</strong>
                    <span data-en="The shop's chat guinea pig">Butikkens chat-marsvin</span>
                </div>
                @* Minimises the window (chat.js) - the conversation is still there when it's opened again. *@
                <button type="button" class="chat-close" aria-label="Minimér chatten" data-en-aria-label="Minimise the chat">&minus;</button>
            </div>
            <p class="chat-msg chat-msg--bot" data-en="Wheek! I'm Pip, the shop's chatbot. Ask me about our guinea pigs, the accessories, care, delivery or the shop. Please don't type personal details here.">Wheek! Jeg er Pip, butikkens chatbot. Spørg mig om vores marsvin, tilbehøret, pasning, levering eller butikken. Skriv ikke personlige oplysninger her.</p>
            <div class="chat-log" role="log" aria-live="polite"></div>
            <form method="post" asp-page="/Chat" class="chat-form">
                <input type="text" name="message" maxlength="@MarsvinWebExample.Pages.ChatModel.MaxQuestionLength" required autocomplete="off"
                       placeholder="Skriv et spørgsmål..." data-en-placeholder="Type a question..."
                       aria-label="Dit spørgsmål" data-en-aria-label="Your question" />
                <button type="submit" class="btn" data-en="Send">Send</button>
            </form>
        </div>
    </details>
}

<script src="~/js/lang-toggle.js" asp-append-version="true"></script>
<script src="~/js/chat.js" asp-append-version="true"></script>
<script src="~/js/confirm-delete.js" asp-append-version="true"></script>
<script src="~/js/print-button.js" asp-append-version="true"></script>
<script src="~/js/mascot-pet.js" asp-append-version="true"></script>
</body>
</html>
