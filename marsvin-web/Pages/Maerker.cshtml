@page
@inject MarsvinWebExample.Data.ICatalog Catalog
@{
    ViewData["Title"] = "Mærker";
    ViewData["TitleEn"] = "Brands";

    var brands = Catalog.Accessories
        .Where(a => a.Brand is not null)
        .GroupBy(a => a.Brand!)
        .OrderBy(g => g.Key)
        .ToList();
}

@* The brands the shop carries, worked out from the catalog itself: each card
   links to /Tilbehor filtered to that brand. Public. *@

<section class="faq-hero">
    <div class="wrap faq-hero-inner">
        <div class="faq-hero-text">
            <h1 data-en="Brands">Mærker</h1>
            <p data-en="The makers behind our accessories. Pick one to see everything we carry from them.">
                Producenterne bag vores tilbehør. Vælg et mærke for at se alt, vi fører fra dem.
            </p>
        </div>
        <img class="faq-hero-photo guide-hero-photo" src="~/img/maerker-marsvin.jpg" width="1200" height="896"
             alt="Et krøllet, hvidt og rødbrunt marsvin blandt hø og salatblade"
             data-en-alt="A curly white and ginger guinea pig among hay and lettuce leaves" />
    </div>
</section>

<section class="section">
    <div class="wrap">
        @if (brands.Count == 0)
        {
            <p data-en="No brands to show yet.">Ingen mærker at vise endnu.</p>
        }
        else
        {
            <ul class="brand-list">
                @foreach (var brand in brands)
                {
                    var categoriesDa = string.Join(", ", brand.Select(a => a.CategoryName).Distinct());
                    var categoriesEn = string.Join(", ", brand.Select(a => a.CategoryNameEn).Distinct());
                    var count = brand.Count();
                    <li>
                        <a asp-page="/Tilbehor/Index" asp-route-maerke="@brand.Key">
                            <div class="receipt-card brand-card">
                                <partial name="_BrandLogo" model="brand.Key" />
                                <div>
                                    <h3>@brand.Key</h3>
                                    <p data-en="@categoriesEn">@categoriesDa</p>
                                    <p class="field-hint" data-en="@(count == 1 ? "1 product" : $"{count} products")">@(count == 1 ? "1 vare" : $"{count} varer")</p>
                                </div>
                            </div>
                        </a>
                    </li>
                }
            </ul>
            <p class="field-hint" data-en="Names and logos belong to their respective owners. This is an example shop for a school project and is not affiliated with any of these brands.">
                Navne og logoer tilhører deres respektive ejere. Dette er en eksempelbutik til et skoleprojekt
                og har ingen tilknytning til nogen af mærkerne.
            </p>
        }
    </div>
</section>
