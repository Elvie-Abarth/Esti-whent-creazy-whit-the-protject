@page
@inject MarsvinWebExample.Data.ICatalog Catalog
@{
    ViewData["Title"] = "Mærker";
    ViewData["TitleEn"] = "Brands";

    var brands = Catalog.Accessories
        .Where(a => a.Brand is not null)
        .GroupBy(a => a.Brand!)
        .OrderBy(g => g.Key)
        .ToList();
}

<div class="wrap section guide-intro">
    <div class="section-head">
        <h1 data-en="Brands">Mærker</h1>
        <p data-en="The makers behind our accessories. Pick one to see everything we carry from them.">
            Producenterne bag vores tilbehør. Vælg et mærke for at se alt, vi fører fra dem.
        </p>
    </div>
</div>

<section class="section">
    <div class="wrap">
        @if (brands.Count == 0)
        {
            <p data-en="No brands to show yet.">Ingen mærker at vise endnu.</p>
        }
        else
        {
            <ul class="brand-list">
                @foreach (var brand in brands)
                {
                    var categoriesDa = string.Join(", ", brand.Select(a => a.CategoryName).Distinct());
                    var categoriesEn = string.Join(", ", brand.Select(a => a.CategoryNameEn).Distinct());
                    var count = brand.Count();
                    <li>
                        <a asp-page="/Tilbehor/Index" asp-route-maerke="@brand.Key">
                            <div class="receipt-card">
                                <h3>@brand.Key</h3>
                                <p data-en="@categoriesEn">@categoriesDa</p>
                                <p class="field-hint" data-en="@(count == 1 ? "1 product" : $"{count} products")">@(count == 1 ? "1 vare" : $"{count} varer")</p>
                            </div>
                        </a>
                    </li>
                }
            </ul>
            <p class="field-hint" data-en="The brand names here are made up for this example shop.">
                Mærkenavnene her er opdigtede til denne eksempelbutik.
            </p>
        }
    </div>
</section>
