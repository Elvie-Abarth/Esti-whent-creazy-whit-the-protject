@page
@model ErrorModel
@{
    ViewData["Title"] = "Siden findes ikke";
    ViewData["TitleEn"] = "Page not found";
}

<div class="wrap section">
    <h1 data-en="This page doesn't exist">Den side findes ikke</h1>
    <p data-en="The link points nowhere. Try the guinea pigs or the accessories — or call the shop if you were looking for a specific animal.">
        Linket peger ingen steder hen. Prøv marsvinene eller tilbehøret —
        eller ring til butikken hvis du ledte efter et bestemt dyr.
    </p>
    <div class="actions">
        <a class="btn" asp-page="/Marsvin/Index" data-en="See the guinea pigs">Se marsvinene</a>
        <a class="btn btn--quiet" asp-page="/Index" data-en="Back to the front page">Til forsiden</a>
    </div>
</div>
