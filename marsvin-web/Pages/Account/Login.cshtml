@page
@model MarsvinWebExample.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log ind";
    ViewData["TitleEn"] = "Log in";
}

<div class="wrap section auth-page">
    <div class="section-head">
        <div>
            <h2 data-en="Log in">Log ind</h2>
            <p data-en="For customers, employees, and the shop owner.">For kunder, medarbejdere og butiksejeren.</p>
            <p data-en="For security, we'll email you a confirmation link after your password - open it to finish logging in.">
                Af sikkerhedsmæssige årsager sender vi dig et bekræftelseslink på e-mail efter din adgangskode - åbn det for at fuldføre login.
            </p>
        </div>
    </div>

    <form method="post" class="auth-form" asp-route-returnUrl="@Model.ReturnUrl">
        <div asp-validation-summary="All" class="form-errors"></div>

        <label>
            <span data-en="Email">E-mail</span>
            <input asp-for="Input.Email" autocomplete="email" />
        </label>

        <label>
            <span data-en="Password">Adgangskode</span>
            <input asp-for="Input.Password" autocomplete="current-password" />
        </label>

        <button type="submit" class="btn" data-en="Log in">Log ind</button>
    </form>

    <p class="auth-switch">
        <span data-en="New here?">Ny her?</span>
        <a asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl" data-en="Create an account">Opret konto</a>
    </p>
</div>
