@page
@model MarsvinWebExample.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Vælg ny adgangskode";
    ViewData["TitleEn"] = "Choose a new password";
}

<div class="wrap section auth-page">
    @if (!Model.TokenIsValid)
    {
        <div class="section-head">
            <div>
                <h2 data-en="This link no longer works">Linket virker ikke længere</h2>
                <p data-en="It's expired, already used, or invalid. Request a new one below.">
                    Det er udløbet, allerede brugt, eller ugyldigt. Anmod om et nyt herunder.
                </p>
            </div>
        </div>
        <div class="actions">
            <a class="btn" asp-page="/Account/ForgotPassword" data-en="Request a new link">Anmod om et nyt link</a>
        </div>
    }
    else
    {
        <div class="section-head">
            <div>
                <h2 data-en="Choose a new password">Vælg ny adgangskode</h2>
            </div>
        </div>

        <form method="post" class="auth-form">
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="All" class="form-errors"></div>

            <label>
                <span data-en="New password">Ny adgangskode</span>
                <input asp-for="Input.NewPassword" autocomplete="new-password" />
            </label>

            <label>
                <span data-en="Confirm new password">Gentag ny adgangskode</span>
                <input asp-for="Input.ConfirmNewPassword" autocomplete="new-password" />
            </label>

            <button type="submit" class="btn" data-en="Save new password">Gem ny adgangskode</button>
        </form>
    }
</div>
