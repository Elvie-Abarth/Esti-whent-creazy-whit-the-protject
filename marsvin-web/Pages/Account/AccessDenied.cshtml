@page
@{
    ViewData["Title"] = "Ingen adgang";
    ViewData["TitleEn"] = "Access denied";
}

@* Where a signed-in user lands when their role isn't allowed on a page - for
   example an Employee opening an Admin-only address. The redirect comes from
   the cookie authentication set up in Program.cs. *@

<div class="wrap section">
    <div class="section-head">
        <div>
            <h2 data-en="Access denied">Ingen adgang</h2>
            <p data-en="Your account doesn't have permission to see this page.">Din konto har ikke adgang til denne side.</p>
        </div>
    </div>
    <div class="actions">
        <a class="btn btn--quiet" asp-page="/Index" data-en="Back to the front page">Til forsiden</a>
    </div>
</div>
