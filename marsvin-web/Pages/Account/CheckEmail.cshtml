@page
@{
    ViewData["Title"] = "Tjek din mail";
    ViewData["TitleEn"] = "Check your email";
    var purpose = Request.Query["purpose"].ToString();
}

<div class="wrap section auth-page">
    <div class="section-head">
        <div>
            <h2 data-en="Check your email">Tjek din mail</h2>
            @if (purpose == "register")
            {
                <p data-en="We've sent a confirmation link to the email address you signed up with. Open it to finish creating your account - it's valid for 15 minutes and only works once.">
                    Vi har sendt et bekræftelseslink til e-mailadressen du oprettede kontoen med.
                    Åbn det for at fuldføre oprettelsen - det er gyldigt i 15 minutter, og
                    virker kun én gang.
                </p>
            }
            else if (purpose == "reset")
            {
                <p data-en="If that email matches an account, we've sent a link to choose a new password. Open it within 15 minutes - it only works once.">
                    Hvis den e-mail matcher en konto, har vi sendt et link til at vælge en ny adgangskode.
                    Åbn det inden for 15 minutter - det virker kun én gang.
                </p>
            }
            else
            {
                <p data-en="We've sent a confirmation link to the email address on your account. Open it to finish logging in - it's valid for 15 minutes and only works once.">
                    Vi har sendt et bekræftelseslink til e-mailadressen på din konto.
                    Åbn det for at fuldføre login - det er gyldigt i 15 minutter, og
                    virker kun én gang.
                </p>
            }
        </div>
    </div>
</div>
