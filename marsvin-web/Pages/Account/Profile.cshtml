@page
@model MarsvinWebExample.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Min konto";
    ViewData["TitleEn"] = "My account";

    string StatusClass(TimeOffStatus s) => s switch
    {
        TimeOffStatus.Approved => "status--approved",
        TimeOffStatus.Denied => "status--denied",
        _ => "status--pending"
    };
    string StatusLabel(TimeOffStatus s) => s switch
    {
        TimeOffStatus.Approved => "Godkendt",
        TimeOffStatus.Denied => "Afvist",
        _ => "Afventer"
    };
    string StatusLabelEn(TimeOffStatus s) => s switch
    {
        TimeOffStatus.Approved => "Approved",
        TimeOffStatus.Denied => "Denied",
        _ => "Pending"
    };
}

<div class="wrap section auth-page">
    <div class="section-head">
        <div>
            <h2 data-en="Account settings">Kontoindstillinger</h2>
            <p data-en="Update your name, email, or password.">Opdatér dit navn, din e-mail, eller din adgangskode.</p>
        </div>
    </div>

    <form method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>

        <label>
            <span data-en="Name">Navn</span>
            <input asp-for="Input.DisplayName" autocomplete="name" />
            <span asp-validation-for="Input.DisplayName" class="field-error"></span>
        </label>

        <label>
            <span data-en="Email">E-mail</span>
            <input asp-for="Input.Email" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </label>

        <label>
            <span data-en="New password (leave blank to keep your current one)">Ny adgangskode (lad stå tom for at beholde din nuværende)</span>
            <input asp-for="Input.NewPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword" class="field-error"></span>
        </label>

        <label>
            <span data-en="Confirm new password">Gentag ny adgangskode</span>
            <input asp-for="Input.ConfirmNewPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmNewPassword" class="field-error"></span>
        </label>

        <label>
            <span data-en="Current password (required to save any change)">Nuværende adgangskode (kræves for at gemme ændringer)</span>
            <input asp-for="Input.CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
        </label>

        <button type="submit" class="btn" data-en="Save changes">Gem ændringer</button>
    </form>
</div>

<section class="section section--paper">
    <div class="wrap">
        <div class="section-head">
            <div>
                <h2 data-en="Two-factor login (2FA)">To-faktor login (2FA)</h2>
                <p data-en="Require a code from an authenticator app (Google Authenticator, Microsoft Authenticator, etc.) in addition to your password when logging in.">
                    Kræv en kode fra en authenticator-app (Google Authenticator, Microsoft Authenticator m.fl.) ud over din adgangskode ved login.
                </p>
            </div>
        </div>

        @if (Model.TotpEnabled)
        {
            <p data-en="2FA is enabled on your account.">2FA er aktiveret på din konto.</p>
            <form method="post" asp-page-handler="DisableTotp" class="auth-form"
                  data-confirm="Er du sikker på, du vil deaktivere 2FA?">
                <label>
                    <span data-en="Current password">Nuværende adgangskode</span>
                    <input type="password" name="currentPassword" required autocomplete="current-password" />
                </label>
                <button type="submit" class="btn btn--quiet" data-en="Disable 2FA">Deaktivér 2FA</button>
            </form>
        }
        else if (Model.PendingTotpSecret is not null)
        {
            <p data-en="Scan this with your authenticator app (or enter the code below by hand), then enter the 6-digit code it shows to finish enabling 2FA.">
                Scan denne med din authenticator-app (eller indtast koden nedenfor manuelt), og indtast derefter den 6-cifrede kode den viser for at aktivere 2FA.
            </p>
            <img src="@Model.PendingTotpQrCodeDataUri" alt="QR-kode til opsætning af 2FA" width="200" height="200" style="display:block;margin:0.5rem 0 1rem;image-rendering:pixelated;" />
            <p><code>@Model.PendingTotpSecret</code></p>

            <form method="post" asp-page-handler="ConfirmTotp" class="auth-form">
                <label>
                    <span data-en="Code from your authenticator app">Kode fra din authenticator-app</span>
                    <input type="text" name="code" inputmode="numeric" pattern="[0-9]*" maxlength="6" required />
                </label>
                <button type="submit" class="btn" data-en="Confirm and enable">Bekræft og aktivér</button>
            </form>
            <form method="post" asp-page-handler="StartTotpEnrollment">
                <button type="submit" class="btn btn--quiet" data-en="Generate a new code instead">Generér en ny kode i stedet</button>
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="StartTotpEnrollment">
                <button type="submit" class="btn" data-en="Enable 2FA">Aktivér 2FA</button>
            </form>
        }
    </div>
</section>

@if (User.IsInRole("Employee") || User.IsInRole("Admin"))
{
    <section class="section section--paper">
        <div class="wrap">
            <div class="section-head">
                <div>
                    <h2 data-en="Your work">Dit arbejde</h2>
                    <p data-en="@($"{Model.TotalWorkHours:0.#} scheduled hours in total - see Vagtplan in the staff area for the full schedule.")">
                        @Model.TotalWorkHours.ToString("0.#") timer i alt planlagt - se Vagtplan i personaleområdet for den fulde plan.
                    </p>
                </div>
            </div>

            @if (User.IsInRole("Employee"))
            {
                @if (Model.MyTimeOffRequests.Count == 0)
                {
                    <p data-en="No day-off requests yet.">Ingen ferieanmodninger endnu.</p>
                }
                else
                {
                    <table class="cart-table">
                        <thead>
                            <tr>
                                <th data-en="Period">Periode</th>
                                <th data-en="Reason">Begrundelse</th>
                                <th data-en="Status">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model.MyTimeOffRequests)
                            {
                                <tr>
                                    <td>@request.StartDate.ToString("d MMM") – @request.EndDate.ToString("d MMM yyyy")</td>
                                    <td>@request.Reason</td>
                                    <td>
                                        <span class="status @StatusClass(request.Status)" data-en="@StatusLabelEn(request.Status)">@StatusLabel(request.Status)</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <h3 data-en="Request time off">Anmod om fri</h3>
                <form method="post" asp-page-handler="RequestTimeOff" class="auth-form">
                    <label>
                        <span data-en="From">Fra</span>
                        <input type="date" name="startDate" required />
                    </label>
                    <label>
                        <span data-en="To">Til</span>
                        <input type="date" name="endDate" required />
                    </label>
                    <label>
                        <span data-en="Reason (optional)">Begrundelse (valgfrit)</span>
                        <input type="text" name="reason" maxlength="500" />
                    </label>
                    <button type="submit" class="btn" data-en="Send request">Send anmodning</button>
                </form>
            }
        </div>
    </section>
}

@if (User.IsInRole("Customer"))
{
    <section class="section section--paper">
        <div class="wrap">
            <div class="section-head">
                <div>
                    <h2 data-en="Order history">Ordrehistorik</h2>
                    <p data-en="Everything you've bought, most recent first.">Alt du har købt, det seneste øverst.</p>
                </div>
            </div>

            @if (Model.Orders.Count == 0)
            {
                <p data-en="No orders yet.">Ingen ordrer endnu.</p>
            }
            else
            {
                @foreach (var order in Model.Orders)
                {
                    <div class="callout order-history-item">
                        <div class="section-head">
                            <div>
                                <h3 data-en="@($"Order #{order.OrderId}")">Ordre #@order.OrderId</h3>
                                <p class="cavy-meta">@order.CreatedAt.ToString("d MMM yyyy HH:mm")</p>
                            </div>
                        </div>

                        <table class="cart-table">
                            <thead>
                                <tr>
                                    <th data-en="Item">Vare</th>
                                    <th data-en="Quantity">Antal</th>
                                    <th data-en="Price">Pris</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in order.Items)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.LineTotal.ToString("N0") kr.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <p class="cart-total">
                            <strong data-en="Total">I alt</strong>: @order.TotalPrice.ToString("N0") kr.
                        </p>

                        @{
                            var animalNamesInOrder = order.Items.Where(i => i.IsAnimal).Select(i => i.ProductName).ToList();
                        }
                        @if (order.DeliveryMethod == DeliveryMethod.Shipping)
                        {
                            <p class="cavy-meta" data-en="@($"Shipped to: {order.ShippingAddress}")">
                                Sendt til: @order.ShippingAddress
                            </p>
                            @if (animalNamesInOrder.Count > 0)
                            {
                                <p class="cavy-meta" data-en="@($"{string.Join(" and ", animalNamesInOrder)} picked up in store separately.")">
                                    @string.Join(" og ", animalNamesInOrder) afhentet i butikken separat.
                                </p>
                            }
                        }
                        else
                        {
                            <p class="cavy-meta" data-en="Picked up in store.">Afhentet i butikken.</p>
                        }

                        <form method="post" asp-page-handler="Reorder">
                            <input type="hidden" name="orderId" value="@order.OrderId" />
                            <button type="submit" class="btn btn--quiet" data-en="Order these items again">Bestil disse varer igen</button>
                        </form>
                    </div>
                }
            }
        </div>
    </section>

    <section class="section">
        <div class="wrap auth-page">
            <div class="callout callout--danger">
                <h2 data-en="Delete your account">Slet din konto</h2>
                <p data-en="Permanently deletes your account - the same right to erasure described on Privatliv. Your past orders are kept, just no longer linked to any account.">
                    Sletter din konto permanent - den samme ret til sletning
                    som er beskrevet under Privatliv. Dine tidligere ordrer
                    bevares, blot ikke længere knyttet til nogen konto.
                </p>
                <form method="post" asp-page-handler="DeleteAccount"
                      data-confirm="Er du sikker på, du vil slette din konto permanent? Det kan ikke fortrydes."
                      class="auth-form">
                    <label>
                        <span data-en="Current password">Nuværende adgangskode</span>
                        <input type="password" name="currentPassword" required autocomplete="current-password" />
                    </label>
                    <button type="submit" class="btn btn--quiet" data-en="Delete my account">Slet min konto</button>
                </form>
            </div>
        </div>
    </section>
}
