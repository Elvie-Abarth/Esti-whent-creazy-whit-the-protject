@page
@model MarsvinWebExample.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Glemt adgangskode";
    ViewData["TitleEn"] = "Forgot password";
}

<div class="wrap section auth-page">
    <div class="section-head">
        <div>
            <h2 data-en="Forgot your password?">Glemt din adgangskode?</h2>
            <p data-en="Enter the email on your account and we'll send you a link to choose a new password.">
                Angiv e-mailen på din konto, så sender vi dig et link til at vælge en ny adgangskode.
            </p>
        </div>
    </div>

    <form method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>

        <label>
            <span data-en="Email">E-mail</span>
            <input asp-for="Input.Email" autocomplete="email" />
        </label>

        <partial name="_Recaptcha" />

        <button type="submit" class="btn" data-en="Send reset link">Send nulstillingslink</button>
    </form>
</div>
