@page
@model MarsvinWebExample.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Glemt adgangskode";
    ViewData["TitleEn"] = "Forgot password";
}

@* The shared page top (see .faq-hero in site.css), with the one-field form
   sitting right under the intro instead of in a section of its own - the
   whole page is the heading, a sentence, an email field and a button. *@
<section class="faq-hero">
    <div class="wrap faq-hero-inner">
        <div class="faq-hero-text">
            <h1 data-en="Forgot your password?">Glemt din adgangskode?</h1>
            <p data-en="Enter the email on your account and we'll send you a link to choose a new password.">
                Angiv e-mailen på din konto, så sender vi dig et link til at vælge en ny adgangskode.
            </p>

            <form method="post" class="auth-form hero-form">
                <div asp-validation-summary="ModelOnly" class="form-errors"></div>

                <label>
                    <span data-en="Email">E-mail</span>
                    <input asp-for="Input.Email" autocomplete="email" />
                </label>

                <partial name="_Recaptcha" />

                <button type="submit" class="btn" data-en="Send reset link">Send nulstillingslink</button>
            </form>

            <p class="field-hint">
                <a asp-page="/Account/Login" data-en="Back to log in">Tilbage til log ind</a>
            </p>
        </div>
        <img class="faq-hero-photo faq-hero-photo--wide" src="~/img/glemt-adgangskode-marsvin.jpg" width="1200" height="675"
             alt="Et rødbrunt og hvidt marsvin med en taleboble med et spørgsmålstegn"
             data-en-alt="A ginger and white guinea pig with a speech bubble holding a question mark" />
    </div>
</section>
