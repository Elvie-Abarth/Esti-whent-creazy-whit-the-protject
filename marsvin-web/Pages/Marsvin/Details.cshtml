@page "{id:int}"
@model MarsvinWebExample.Pages.Marsvin.DetailsModel
@{
    ViewData["Title"] = Model.Animal.Name;
    ViewData["TitleEn"] = Model.Animal.Name;
    var a = Model.Animal;
}

<div class="wrap">
    <div class="detail">
        <div>
            <partial name="_Cavy" model="a" />
        </div>

        <div>
            <a class="back" asp-page="/Marsvin/Index" data-en="Back to the guinea pigs">Tilbage til marsvinene</a>

            <h1>@a.Name</h1>
            <p data-en="@(a.DescriptionEn ?? a.Description)">@a.Description</p>
            <p data-en="@(a.PersonalityEn ?? a.Personality)">@a.Personality</p>

            <ul class="facts">
                <li><span data-en="Breed">Race</span><span data-en="@(a.BreedEn ?? a.Breed)">@a.Breed</span></li>
                <li><span data-en="Sex">Køn</span><span data-en="@a.SexNameEn">@a.SexName</span></li>
                <li><span data-en="Age">Alder</span><span data-en="@a.AgeTextEn">@a.AgeText</span></li>
                <li><span data-en="Colour">Farve</span><span data-en="@(a.ColourEn ?? a.Colour)">@a.Colour</span></li>
                <li><span data-en="Status">Status</span><span class="@a.StatusClass" data-en="@a.StatusTextEn">@a.StatusText</span></li>
                <li><span data-en="Price">Pris</span><span class="price">@a.Price.ToString("N0") kr.</span></li>
            </ul>

            @if (Model.Partner is not null)
            {
                <div class="callout">
                    <p>
                        <span data-en="@($"{a.Name} lives together with")">@a.Name bor sammen med</span>
                        <a asp-page="/Marsvin/Details" asp-route-id="@Model.Partner.ProductId">@Model.Partner.Name</a>.
                        <span data-en="@($"The two move in together — combined price {(a.Price + Model.Partner.Price).ToString("N0")} kr.")">
                            De to flytter sammen — samlet pris
                            @((a.Price + Model.Partner.Price).ToString("N0")) kr.
                        </span>
                    </p>
                </div>
            }

            @if (Model.Partner is null && a.Status == AnimalStatus.Available)
            {
                <div class="callout">
                    <p data-en="@($"Guinea pigs are herd animals. {a.Name} isn't paired with another guinea pig here, so we only sell {a.Name} once you confirm it's joining a guinea pig or herd you already have.")">
                        Marsvin er flokdyr. @a.Name er ikke sat sammen med et andet
                        marsvin her, så vi sælger kun @a.Name, når du bekræfter, det
                        tilføjes et marsvin eller en flok, du allerede har.
                    </p>
                </div>
            }

            @if (!a.IsOldEnoughToSell())
            {
                <div class="callout">
                    <p data-en="@($"{a.Name} is {a.AgeInWeeks()} weeks old and is still with its mother. Guinea pigs leave home no earlier than four weeks old.")">
                        @a.Name er @a.AgeInWeeks() uger gammel og er stadig hos sin mor.
                        Marsvin flytter tidligst hjemmefra som fire uger gamle.
                    </p>
                </div>
            }

            <div class="actions">
                @if (a.Status == AnimalStatus.Available && a.IsOldEnoughToSell())
                {
                    if (User.IsInRole("Employee") || User.IsInRole("Admin"))
                    {
                        <span class="btn" aria-disabled="true" data-en="Staff accounts can't buy">Personalekonti kan ikke købe</span>
                    }
                    else if (User.Identity?.IsAuthenticated != true)
                    {
                        @* A POST to add-to-cart can't survive a login redirect (the form
                           body is lost, so the add would silently fail after logging in).
                           Send the customer to log in and back to this exact page instead,
                           so they can add it for real once they're actually signed in. *@
                        <a class="btn" asp-page="/Account/Login" asp-route-returnUrl="@Request.Path" data-en="Log in to buy">Log ind for at købe</a>
                    }
                    else
                    {
                        <form method="post" asp-page="/Cart/Index" asp-page-handler="Add" class="auth-form">
                            <input type="hidden" name="productId" value="@a.ProductId" />
                            <input type="hidden" name="quantity" value="1" />
                            <input type="hidden" name="returnUrl" value="@Request.Path" />
                            @if (Model.Partner is null)
                            {
                                <label>
                                    <span data-en="Which guinea pig or herd will it join?">Hvilket marsvin eller hvilken flok tilføjes det til?</span>
                                    <input type="text" name="companionNote" required maxlength="200"
                                           placeholder="F.eks. 'mit marsvin Nisse' eller 'min flok på tre'" />
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" name="confirmNotAlone" value="true" required />
                                    <span data-en="@($"I confirm {a.Name} will not live alone")">Jeg bekræfter at @a.Name ikke skal bo alene</span>
                                </label>
                            }
                            <button type="submit" class="btn" data-en="Add to cart">Læg i kurv</button>
                        </form>
                    }
                }
                else
                {
                    <span class="btn" aria-disabled="true" data-en="@a.StatusTextEn">@a.StatusText</span>
                }
                <a class="btn btn--quiet" asp-page="/Tilbehor/Index" data-en="Find a cage and hay">Find bur og hø</a>
            </div>

            <p class="cavy-meta" data-en="Guinea pigs are picked up in store. We don't ship live animals.">
                Marsvin hentes i butikken. Vi sender ikke levende dyr med fragt.
            </p>
        </div>
    </div>
</div>
