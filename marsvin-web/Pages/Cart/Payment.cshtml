@page
@using MarsvinWebExample.Models
@model MarsvinWebExample.Pages.Cart.PaymentModel
@{
    ViewData["Title"] = "Betaling";
    ViewData["TitleEn"] = "Payment";
}

<div class="wrap section auth-page">
    <div class="section-head">
        <div>
            <h2 data-en="Payment">Betaling</h2>
            <p data-en="Demo only - no card is charged and no card details are stored anywhere. A real payment integration (Stripe, MobilePay, ...) is future work, not a fake one built for the look of it.">
                Kun til demo - der trækkes ikke penge, og ingen kortoplysninger gemmes nogen steder. En rigtig betalingsløsning (Stripe, MobilePay, ...) er fremtidigt arbejde, ikke noget der efterlignes her for udseendets skyld.
            </p>
        </div>
    </div>

    <table class="cart-table">
        <thead>
            <tr>
                <th data-en="Item">Vare</th>
                <th data-en="Quantity">Antal</th>
                <th data-en="Price">Pris</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.ProductName</td>
                    <td>@line.Quantity</td>
                    <td>@line.LineTotal.ToString("N0") kr.</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="cart-total">
        <strong data-en="Total">I alt</strong>: @Model.Total.ToString("N0") kr.
    </p>

    <form method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>

        <fieldset>
            <legend data-en="Delivery">Levering</legend>
            @if (Model.CanShip)
            {
                <label class="checkbox-label">
                    <input type="radio" asp-for="Input.DeliveryMethod" value="@DeliveryMethod.Pickup" checked="checked" />
                    @if (Model.HasAnimal)
                    {
                        <span data-en="Pick up everything in store">Afhent det hele i butikken</span>
                    }
                    else
                    {
                        <span data-en="Pick up in store">Afhent i butikken</span>
                    }
                </label>
                <label class="checkbox-label">
                    <input type="radio" asp-for="Input.DeliveryMethod" value="@DeliveryMethod.Shipping" />
                    @if (Model.HasAnimal)
                    {
                        <span data-en="Ship the accessories - pick up the guinea pig in store">Send tilbehøret - afhent marsvinet i butikken</span>
                    }
                    else
                    {
                        <span data-en="Ship to my address">Send til min adresse</span>
                    }
                </label>
                @if (Model.HasAnimal)
                {
                    <p class="cavy-meta" data-en="The guinea pig always needs picking up in store, whichever you choose above - only the accessories in this order can be shipped.">
                        Marsvinet skal under alle omstændigheder afhentes i
                        butikken, uanset hvad du vælger ovenfor - det er kun
                        tilbehøret i ordren, der kan sendes.
                    </p>
                }
                <label>
                    <span data-en="Delivery address (only needed if you choose shipping above)">Leveringsadresse (kun nødvendig hvis du vælger forsendelse ovenfor)</span>
                    <input asp-for="Input.ShippingAddress" autocomplete="street-address" />
                    <span asp-validation-for="Input.ShippingAddress" class="field-error"></span>
                </label>
            }
            else
            {
                <input type="hidden" asp-for="Input.DeliveryMethod" value="@DeliveryMethod.Pickup" />
                <p data-en="This order is only guinea pigs, so it's always picked up in store - a guinea pig can't be shipped.">
                    Denne ordre består kun af marsvin, og afhentes derfor
                    altid i butikken - et marsvin kan ikke sendes med fragt.
                </p>
            }
        </fieldset>

        <label>
            <span data-en="Name on card">Navn på kortet</span>
            <input asp-for="Input.CardHolder" autocomplete="cc-name" />
            <span asp-validation-for="Input.CardHolder" class="field-error"></span>
        </label>

        <label>
            <span data-en="Card number (demo)">Kortnummer (demo)</span>
            <input asp-for="Input.CardNumber" autocomplete="cc-number" placeholder="4242 4242 4242 4242" />
            <span asp-validation-for="Input.CardNumber" class="field-error"></span>
        </label>

        <label>
            <span data-en="Expiry (MM/YY)">Udløb (MM/ÅÅ)</span>
            <input asp-for="Input.Expiry" autocomplete="cc-exp" placeholder="12/29" />
            <span asp-validation-for="Input.Expiry" class="field-error"></span>
        </label>

        <label>
            <span>CVC</span>
            <input asp-for="Input.Cvc" autocomplete="cc-csc" placeholder="123" />
            <span asp-validation-for="Input.Cvc" class="field-error"></span>
        </label>

        <button type="submit" class="btn" data-en="Pay now (demo)">Betal nu (demo)</button>
    </form>

    <p class="auth-switch">
        <a asp-page="/Cart/Index" data-en="Back to cart">Tilbage til kurven</a>
    </p>
</div>
