@page
@model MarsvinWebExample.Pages.Cart.PaymentModel
@{
    ViewData["Title"] = "Betaling";
    ViewData["TitleEn"] = "Payment";

    // The steps are numbered as they're rendered - a signed-in customer has
    // no "your details" step, so the numbers can't be hard-coded.
    var step = 0;
    var animalNames = Model.Lines.Where(l => l.IsAnimal).Select(l => l.ProductName).ToList();
    var parcelsDa = Model.ParcelCount == 1 ? "1 pakke" : $"{Model.ParcelCount} pakker";
    var parcelsEn = Model.ParcelCount == 1 ? "1 parcel" : $"{Model.ParcelCount} parcels";
    var weightDa = ShippingCalculator.FormatWeight(Model.ShippableWeightGrams);
    var weightEn = ShippingCalculator.FormatWeight(Model.ShippableWeightGrams, english: true);
}

<div class="wrap section">
    <div class="section-head">
        <div>
            <h2 data-en="Payment">Betaling</h2>
            <p data-en="Demo only - no card is charged and no card details are stored anywhere. A real payment integration (Stripe, MobilePay, ...) is future work, not a fake one built for the look of it.">
                Kun til demo - der trækkes ikke penge, og ingen kortoplysninger gemmes nogen steder. En rigtig betalingsløsning (Stripe, MobilePay, ...) er fremtidigt arbejde, ikke noget der efterlignes her for udseendets skyld.
            </p>
        </div>
    </div>

    <div class="cart-card">
        <table class="cart-table">
            <thead>
                <tr>
                    <th data-en="Item">Vare</th>
                    <th data-en="Quantity">Antal</th>
                    <th data-en="Weight">Vægt</th>
                    <th data-en="Price">Pris</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>
                            <div class="cart-item">
                                @if (!string.IsNullOrEmpty(line.PhotoUrl))
                                {
                                    <img src="@line.PhotoUrl" alt="" class="cart-item-photo" />
                                }
                                <span>@line.ProductName</span>
                            </div>
                        </td>
                        <td>@line.Quantity</td>
                        @if (line.IsAnimal)
                        {
                            <td data-en="Picked up in store">Afhentes i butikken</td>
                        }
                        else
                        {
                            <td data-en="@ShippingCalculator.FormatWeight(line.WeightGrams * line.Quantity, english: true)">@ShippingCalculator.FormatWeight(line.WeightGrams * line.Quantity)</td>
                        }
                        <td>@line.LineTotal.ToString("N0") kr.</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="cart-summary">
            <span class="cart-total"><span data-en="Items total">Varer i alt</span>: @Model.Total.ToString("N0") kr.</span>
        </div>
    </div>
</div>

@* No .section here (just .wrap) - stacking two .section blocks would add
   their top+bottom padding together (up to ~9rem), swamping the 2rem gap
   .payment-card's own margin-top already provides above. payment-wrap just
   closes out the page's bottom padding, matching .section's own formula. *@
<div class="wrap auth-page payment-wrap">
    <form method="post" class="auth-form payment-card">
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>
        @if (!ViewData.ModelState.IsValid)
        {
            <p class="form-errors" role="alert" data-en="Nothing has been paid yet - something is missing or looks wrong. See the fields marked in red below.">
                Der er ikke betalt endnu - noget mangler eller ser forkert ud. Se felterne markeret med rødt nedenfor.
            </p>
        }

        <fieldset>
            <legend class="pay-step"><span class="pay-step-number">@(++step)</span> <span data-en="Your details">Dine oplysninger</span></legend>
            @if (Model.IsGuest)
            {
                <p data-en="You're checking out as a guest - no account needed. Your name and email are only used for the receipt.">
                    Du køber som gæst - ingen konto nødvendig. Navn og e-mail bruges kun til din kvittering.
                </p>
                <label>
                    <span data-en="Name">Navn</span>
                    <input asp-for="Input.GuestName" autocomplete="name" />
                    <span asp-validation-for="Input.GuestName" class="field-error"></span>
                </label>
                <label>
                    <span data-en="Email">E-mail</span>
                    <input asp-for="Input.GuestEmail" autocomplete="email" type="email" />
                    <span asp-validation-for="Input.GuestEmail" class="field-error"></span>
                </label>
            }
            else
            {
                <p data-en="@($"Signed in as {User.Identity!.Name}. The receipt goes to your account's email address.")">
                    Logget ind som @User.Identity!.Name. Kvitteringen sendes til din kontos e-mailadresse.
                </p>
            }

            <label>
                <span data-en="Phone number">Telefonnummer</span>
                <input asp-for="Input.Phone" type="tel" autocomplete="tel" placeholder="12 34 56 78" />
                <span class="field-hint" data-en="Needed for shipping - the carrier texts you when the parcel is on its way or ready to collect. Optional for pickup in store.">
                    Skal udfyldes ved forsendelse - fragtselskabet sender en sms, når pakken er på vej eller klar til afhentning. Valgfrit ved afhentning i butikken.
                </span>
                <span asp-validation-for="Input.Phone" class="field-error"></span>
            </label>

            <div class="buyer-type">
                <label class="checkbox-label delivery-option">
                    <input type="radio" asp-for="Input.BuyerType" value="@BuyerType.Private" />
                    <strong data-en="Private purchase">Privat køb</strong>
                </label>
                <label class="checkbox-label delivery-option">
                    <input type="radio" asp-for="Input.BuyerType" value="@BuyerType.Company" />
                    <span class="option-body">
                        <strong data-en="Company, school or institution">Virksomhed, skole eller institution</strong>
                        <span data-en="Company name and CVR number go on the receipt, with the VAT amount.">Firmanavn og CVR-nummer kommer på kvitteringen sammen med momsbeløbet.</span>
                    </span>
                </label>
            </div>
            <div class="company-only">
                <label>
                    <span data-en="Company name">Virksomhedens navn</span>
                    <input asp-for="Input.CompanyName" autocomplete="organization" />
                    <span asp-validation-for="Input.CompanyName" class="field-error"></span>
                </label>
                <label>
                    <span data-en="CVR number">CVR-nummer</span>
                    <input asp-for="Input.CompanyCvr" inputmode="numeric" maxlength="11" placeholder="12 34 56 74" />
                    <span class="field-hint" data-en="8 digits.">8 cifre.</span>
                    <span asp-validation-for="Input.CompanyCvr" class="field-error"></span>
                </label>
            </div>

            @if (Model.HasAnimal)
            {
                @* A yes/no, not "how old are you?" - see PaymentInputModel.ConfirmAge16. *@
                <label class="checkbox-label delivery-option">
                    <input type="checkbox" asp-for="Input.ConfirmAge16" />
                    <span class="option-body">
                        <strong data-en="I am 16 or older">Jeg er fyldt 16 år</strong>
                        <span data-en="By law, an animal can't be sold to anyone under 16 without a parent's consent. Under 16? Come to the shop with a parent instead.">
                            Efter loven må et dyr ikke sælges til nogen under 16 år uden forældrenes samtykke. Under 16? Kom forbi butikken sammen med en forælder i stedet.
                        </span>
                        <span asp-validation-for="Input.ConfirmAge16" class="field-error"></span>
                    </span>
                </label>
            }

            @if (Model.IsGuest)
            {
                <div class="pay-account-offer">
                    <p data-en="Prefer an account? Then your details are saved and you can follow each order's status. Your cart comes with you.">
                        Hellere en konto? Så gemmes dine oplysninger, og du kan følge hver ordres status. Din kurv følger med.
                    </p>
                    <div class="pay-account-links">
                        <a asp-page="/Account/Register" asp-route-returnUrl="/Cart/Payment" data-en="Create an account">Opret konto</a>
                        <a asp-page="/Account/Login" asp-route-returnUrl="/Cart/Payment" data-en="Log in">Log ind</a>
                    </div>
                </div>
            }
        </fieldset>

        <fieldset>
            <legend class="pay-step"><span class="pay-step-number">@(++step)</span> <span data-en="Delivery">Levering</span></legend>
            @if (Model.CanShip)
            {
                <label class="checkbox-label delivery-option">
                    <input type="radio" asp-for="Input.DeliveryMethod" value="@DeliveryMethod.Pickup" />
                    <span class="option-body">
                        <span class="option-head">
                            <strong data-en="@(Model.HasAnimal ? "Pick up everything in store" : "Pick up in store")">@(Model.HasAnimal ? "Afhent det hele i butikken" : "Afhent i butikken")</strong>
                            <strong class="option-price" data-en="Free">Gratis</strong>
                        </span>
                        <span data-en="Marsvin, Havnegade 12, 6700 Esbjerg">Marsvin, Havnegade 12, 6700 Esbjerg</span>
                    </span>
                </label>
                <label class="checkbox-label delivery-option">
                    <input type="radio" asp-for="Input.DeliveryMethod" value="@DeliveryMethod.Shipping" />
                    <span class="option-body">
                        <span class="option-head">
                            <strong data-en="@(Model.HasAnimal ? "Ship the accessories" : "Have it shipped")">@(Model.HasAnimal ? "Få tilbehøret sendt" : "Få det sendt")</strong>
                            @if (Model.ShippingOptions.Min(o => o.Cost) == 0)
                            {
                                <strong class="option-price" data-en="Free">Gratis</strong>
                            }
                            else
                            {
                                <strong class="option-price" data-en="@($"from {Model.ShippingOptions.Min(o => o.Cost):N0} kr.")">fra @Model.ShippingOptions.Min(o => o.Cost).ToString("N0") kr.</strong>
                            }
                        </span>
                        <span data-en="To your door or to a pick-up point near you">Til din dør eller til et udleveringssted nær dig</span>
                    </span>
                </label>
                @if (Model.HasAnimal)
                {
                    <p class="pay-note" data-en="@($"{string.Join(" and ", animalNames)} must always be picked up in store - a guinea pig can't be shipped. Only the accessories can be sent.")">
                        @string.Join(" og ", animalNames) skal altid afhentes i butikken - et
                        marsvin kan ikke sendes. Kun tilbehøret kan sendes.
                    </p>
                }

                @* Everything below only matters once "shipped" is chosen - hidden
                   until then (see .ship-only in site.css) instead of sitting there
                   labelled "only needed if...". *@
                <div class="ship-only">
                    <label>
                        <span data-en="Delivery address">Leveringsadresse</span>
                        <input asp-for="Input.ShippingAddress" autocomplete="street-address" placeholder="Vejnavn 12, 4000 Roskilde" />
                        <span class="field-hint" data-en="Street and number, postcode and city.">Vej og husnummer, postnummer og by.</span>
                        <span asp-validation-for="Input.ShippingAddress" class="field-error"></span>
                    </label>

                    <div class="pay-box">
                        <h3 data-en="Your shipment">Din forsendelse</h3>
                        <dl class="pay-facts">
                            <dt data-en="Total weight">Samlet vægt</dt>
                            <dd data-en="@weightEn">@weightDa</dd>
                            <dt data-en="Number of parcels">Antal pakker</dt>
                            <dd data-en="@($"{parcelsEn} (max. 20 kg each)")">@parcelsDa (højst 20 kg pr. pakke)</dd>
                        </dl>
                    </div>

                    <fieldset class="carrier-fieldset">
                        <legend data-en="Choose a carrier">Vælg fragtselskab</legend>
                        @foreach (var option in Model.ShippingOptions)
                        {
                            var toShop = option.Carrier.DeliversToParcelShop();
                            <label class="checkbox-label delivery-option carrier-option">
                                <input type="radio" asp-for="Input.ShippingCarrier" value="@option.Carrier" />
                                <span class="option-body">
                                    <span class="option-head">
                                        <strong data-en="@option.Carrier.DisplayName(english: true)">@option.Carrier.DisplayName()</strong>
                                        @if (option.Cost == 0)
                                        {
                                            <strong class="option-price" data-en="Free">Gratis</strong>
                                        }
                                        else
                                        {
                                            <strong class="option-price">@option.Cost.ToString("N0") kr.</strong>
                                        }
                                    </span>
                                    <span class="pay-facts">
                                        <span data-en="Delivered to">Leveres til</span>
                                        @if (toShop)
                                        {
                                            <strong data-en="Pick-up point near you">Udleveringssted nær dig</strong>
                                        }
                                        else
                                        {
                                            <strong data-en="Your door, at the address above">Din dør, på adressen ovenfor</strong>
                                        }
                                        <span data-en="Expected delivery">Forventet levering</span>
                                        <strong>@option.DeliveryWindowText</strong>
                                    </span>
                                </span>
                            </label>
                        }
                        <p class="field-hint" data-en="Dates are day/month and an estimate: weekdays only, counted from today. For a pick-up point, the carrier picks the one nearest your address and messages you when the parcel is ready.">
                            Datoer er dag/måned og et skøn: kun hverdage, regnet fra i dag. Ved udleveringssted
                            vælger fragtselskabet den nærmeste på din adresse og giver besked, når pakken er klar.
                        </p>
                    </fieldset>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="Input.DeliveryMethod" value="@DeliveryMethod.Pickup" />
                <p data-en="This order is only guinea pigs, so it's picked up in store - a guinea pig can't be shipped. Pickup is free.">
                    Denne ordre består kun af marsvin og afhentes derfor
                    i butikken - et marsvin kan ikke sendes. Afhentning er gratis.
                </p>
            }
        </fieldset>

        <fieldset>
            <legend class="pay-step"><span class="pay-step-number">@(++step)</span> <span data-en="Payment method">Betalingsmetode</span></legend>
            <label class="checkbox-label delivery-option">
                <input type="radio" asp-for="Input.PaymentMethod" value="@PaymentMethod.Card" />
                <strong data-en="Card">Kort</strong>
            </label>
            <label class="checkbox-label delivery-option">
                <input type="radio" asp-for="Input.PaymentMethod" value="@PaymentMethod.MobilePay" />
                <strong>MobilePay</strong>
            </label>

            <div class="card-fields">
                @* Shown by payment.js - it's what fills the fields in. *@
                <button type="button" class="btn btn--quiet demo-card" data-demo-card hidden data-en="Fill in a demo card">Udfyld et demokort</button>
                <label>
                    <span data-en="Name on card">Navn på kortet</span>
                    <input asp-for="Input.CardHolder" autocomplete="cc-name" />
                    <span asp-validation-for="Input.CardHolder" class="field-error"></span>
                </label>

                <label>
                    <span data-en="Card number (demo)">Kortnummer (demo)</span>
                    <input asp-for="Input.CardNumber" autocomplete="cc-number" inputmode="numeric" maxlength="23" placeholder="4242 4242 4242 4242" />
                    <span asp-validation-for="Input.CardNumber" class="field-error"></span>
                </label>

                <div class="card-expiry-row">
                    <label>
                        <span data-en="Expiry (MM/YY)">Udløb (MM/ÅÅ)</span>
                        <input asp-for="Input.Expiry" autocomplete="cc-exp" inputmode="numeric" maxlength="7" placeholder="12/29" />
                        <span asp-validation-for="Input.Expiry" class="field-error"></span>
                    </label>

                    <label>
                        <span>CVC</span>
                        <input asp-for="Input.Cvc" autocomplete="cc-csc" inputmode="numeric" maxlength="4" placeholder="123" />
                        <span asp-validation-for="Input.Cvc" class="field-error"></span>
                    </label>
                </div>
            </div>

            <p class="pay-note mobilepay-note" data-en="You'll get a payment request in the MobilePay app once you confirm (demo only - nothing is actually sent or charged).">
                Du får en betalingsanmodning i MobilePay-appen, når du bekræfter (kun demo - der sendes og trækkes intet i virkeligheden).
            </p>
        </fieldset>

        @* One summary per possible choice (pickup, or shipping with each
           carrier), all rendered up front; site.css shows only the one that
           matches the radios currently selected. No JS, so the amount the
           buyer is about to pay is always right there above the button. *@
        <section class="pay-summary">
            <h3 class="pay-step"><span class="pay-step-number">@(++step)</span> <span data-en="Your order">Din ordre</span></h3>

            <div class="pay-summary-variant @(Model.CanShip ? "pay-summary--Pickup" : "pay-summary--only")">
                <dl class="pay-facts">
                    <dt data-en="Items">Varer</dt>
                    <dd>@Model.Total.ToString("N0") kr.</dd>
                    <dt data-en="Delivery">Levering</dt>
                    <dd data-en="Pickup in store - free">Afhentning i butikken - gratis</dd>
                    <dt data-en="Where">Hvor</dt>
                    <dd data-en="Marsvin, Havnegade 12, 6700 Esbjerg">Marsvin, Havnegade 12, 6700 Esbjerg</dd>
                    <dt data-en="Opening hours">Åbningstider</dt>
                    <dd data-en="Thursday and Friday 14-18, Saturday 10-14">Torsdag og fredag 14-18, lørdag 10-14</dd>
                    <dt class="pay-total" data-en="To pay">At betale</dt>
                    <dd class="pay-total">@Model.Total.ToString("N0") kr.</dd>
                </dl>
            </div>

            @if (Model.CanShip)
            {
                @foreach (var option in Model.ShippingOptions)
                {
                    <div class="pay-summary-variant pay-summary--@option.Carrier">
                        <dl class="pay-facts">
                            <dt data-en="Items">Varer</dt>
                            <dd>@Model.Total.ToString("N0") kr.</dd>
                            <dt data-en="@($"Shipping ({option.Carrier.DisplayName(english: true)})")">Fragt (@option.Carrier.DisplayName())</dt>
                            @if (option.Cost == 0)
                            {
                                <dd data-en="@($"Free - your order is over {ShippingCalculator.FreeShippingThreshold:N0} kr.")">Gratis - din ordre er over @ShippingCalculator.FreeShippingThreshold.ToString("N0") kr.</dd>
                            }
                            else
                            {
                                <dd>@option.Cost.ToString("N0") kr.</dd>
                            }
                            <dt data-en="Delivered to">Leveres til</dt>
                            @if (option.Carrier.DeliversToParcelShop())
                            {
                                <dd data-en="Pick-up point near you">Udleveringssted nær dig</dd>
                            }
                            else
                            {
                                <dd data-en="Your door">Din dør</dd>
                            }
                            <dt data-en="Expected delivery">Forventet levering</dt>
                            <dd>@option.DeliveryWindowText</dd>
                            <dt data-en="Shipment">Forsendelse</dt>
                            <dd data-en="@($"{weightEn} in {parcelsEn}")">@weightDa i @parcelsDa</dd>
                            @if (Model.HasAnimal)
                            {
                                <dt data-en="Picked up in store">Afhentes i butikken</dt>
                                <dd>@string.Join(", ", animalNames)</dd>
                            }
                            <dt class="pay-total" data-en="To pay">At betale</dt>
                            <dd class="pay-total">@((Model.Total + option.Cost).ToString("N0")) kr.</dd>
                        </dl>
                    </div>
                }
            }
        </section>

        <button type="submit" class="btn" data-en="Pay now (demo)">Betal nu (demo)</button>
    </form>

    <div class="actions">
        <a class="btn btn--quiet" asp-page="/Cart/Index" data-en="Back to cart">Tilbage til kurven</a>
    </div>
</div>

<script src="~/js/payment.js" asp-append-version="true"></script>
