@page
@model MarsvinWebExample.Pages.Cart.IndexModel
@{
    ViewData["Title"] = "Kurv";
    ViewData["TitleEn"] = "Cart";
}

<div class="wrap section">
    <div class="section-head">
        <div>
            <h2 data-en="Your cart">Din kurv</h2>
        </div>
    </div>

    @if (Model.Lines.Count == 0)
    {
        <p data-en="Your cart is empty.">Din kurv er tom.</p>
        <div class="actions">
            <a class="btn btn--quiet" asp-page="/Marsvin/Index" data-en="See the guinea pigs">Se marsvinene</a>
            <a class="btn btn--quiet" asp-page="/Tilbehor/Index" data-en="See accessories">Se tilbehør</a>
        </div>
    }
    else
    {
        <table class="cart-table">
            <thead>
                <tr>
                    <th data-en="Item">Vare</th>
                    <th data-en="Quantity">Antal</th>
                    <th data-en="Price">Pris</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>@line.ProductName</td>
                        <td>
                            @if (line.IsAnimal)
                            {
                                @line.Quantity
                            }
                            else
                            {
                                <form method="post" asp-page-handler="UpdateQuantity" class="inline-form">
                                    <input type="hidden" name="productId" value="@line.ProductId" />
                                    <input type="number" name="quantity" value="@line.Quantity" min="1" aria-label="Antal" />
                                    <button type="submit" class="btn btn--quiet" data-en="Update">Opdatér</button>
                                </form>
                            }
                        </td>
                        <td>@line.LineTotal.ToString("N0") kr.</td>
                        <td>
                            <form method="post" asp-page-handler="Remove">
                                <input type="hidden" name="productId" value="@line.ProductId" />
                                <button type="submit" class="btn btn--quiet" data-en="Remove">Fjern</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="cart-total">
            <strong data-en="Total">I alt</strong>: @Model.Total.ToString("N0") kr.
        </p>

        <a class="btn" asp-page="/Cart/Payment" data-en="Check out">Gennemfør køb</a>
    }
</div>
