@page "{orderId:int}"
@using MarsvinWebExample.Models
@model MarsvinWebExample.Pages.Cart.ConfirmationModel
@{
    ViewData["Title"] = "Tak for din bestilling";
    ViewData["TitleEn"] = "Thank you for your order";
}

<div class="wrap section">
    <div class="section-head">
        <div>
            <h2 data-en="Thank you for your order!">Tak for din bestilling!</h2>
            <p data-en="@($"Order #{Model.Order.OrderId}, placed {Model.Order.CreatedAt:d MMM yyyy HH:mm}.")">
                Ordre #@Model.Order.OrderId, oprettet @Model.Order.CreatedAt.ToString("d MMM yyyy HH:mm").
            </p>
        </div>
    </div>

    <table class="cart-table">
        <thead>
            <tr>
                <th data-en="Item">Vare</th>
                <th data-en="Quantity">Antal</th>
                <th data-en="Price">Pris</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Order.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>@item.LineTotal.ToString("N0") kr.</td>
                </tr>
            }
        </tbody>
    </table>

    <p class="cart-total">
        <strong data-en="Total">I alt</strong>: @Model.Order.TotalPrice.ToString("N0") kr.
    </p>

    @if (Model.Order.DeliveryMethod == DeliveryMethod.Shipping)
    {
        <p data-en="@($"This order will be shipped to: {Model.Order.ShippingAddress}")">
            Denne ordre sendes til: @Model.Order.ShippingAddress
        </p>
    }
    else
    {
        <p data-en="This order is picked up in store - guinea pigs always are, and that's what you chose for this one.">
            Denne ordre afhentes i butikken - det gælder altid for marsvin, og det er hvad du valgte til denne ordre.
        </p>
    }

    <div class="actions">
        <a class="btn btn--quiet" asp-page="/Index" data-en="Back to the front page">Til forsiden</a>
    </div>
</div>
