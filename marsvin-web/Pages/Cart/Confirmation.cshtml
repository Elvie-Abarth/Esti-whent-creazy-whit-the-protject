@page "{orderId:int}"
@model MarsvinWebExample.Pages.Cart.ConfirmationModel
@{
    ViewData["Title"] = "Tak for din bestilling";
    ViewData["TitleEn"] = "Thank you for your order";
}

<div class="wrap section">
    <div class="section-head">
        <div>
            <h2 data-en="Thank you for your order!">Tak for din bestilling!</h2>
            <p data-en="@($"Order #{Model.Order.OrderId}, placed {Model.Order.CreatedAt:d MMM yyyy HH:mm}.")">
                Ordre #@Model.Order.OrderId, oprettet @Model.Order.CreatedAt.ToString("d MMM yyyy HH:mm").
            </p>
        </div>
    </div>

    <div class="cart-card">
        <table class="cart-table">
            <thead>
                <tr>
                    <th data-en="Item">Vare</th>
                    <th data-en="Quantity">Antal</th>
                    <th data-en="Price">Pris</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Order.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@item.LineTotal.ToString("N0") kr.</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="cart-summary">
            <span class="cart-total"><span data-en="Total">I alt</span>: @Model.Order.TotalPrice.ToString("N0") kr.</span>
        </div>
    </div>

    @{
        var animalNames = Model.Order.Items.Where(i => i.IsAnimal).Select(i => i.ProductName).ToList();
    }
    @if (Model.Order.DeliveryMethod == DeliveryMethod.Shipping)
    {
        <p data-en="@($"The accessories in this order will be shipped to: {Model.Order.ShippingAddress}")">
            Tilbehøret i denne ordre sendes til: @Model.Order.ShippingAddress
        </p>
        @if (animalNames.Count > 0)
        {
            <p class="cavy-meta" data-en="@($"{string.Join(" and ", animalNames)} still needs to be picked up in store - a guinea pig can't be shipped, regardless of the rest of the order.")">
                @string.Join(" og ", animalNames) skal stadig afhentes i
                butikken - et marsvin kan ikke sendes med fragt, uanset resten
                af ordren.
            </p>
        }
    }
    else
    {
        <p data-en="This order is picked up in store.">
            Denne ordre afhentes i butikken.
        </p>
    }

    <div class="actions">
        <a class="btn btn--quiet" asp-page="/Index" data-en="Back to the front page">Til forsiden</a>
    </div>
</div>

<script src="~/js/confetti.js" asp-append-version="true"></script>
