@page
@{
    ViewData["Title"] = "Foderliste";
}

<div class="wrap section guide-intro">
    <div class="actions no-print">
        <a class="btn btn--quiet" asp-page="/Pasningsguide" data-en="Back to the care guide">Tilbage til pasningsguiden</a>
        <button type="button" class="btn" onclick="window.print()" data-en="Print or save as PDF">Udskriv / gem som PDF</button>
    </div>
    <div class="section-head">
        <h1 data-en="Guinea pig food list">Marsvins foderliste</h1>
        <p data-en="What's safe every day, what's fine in small amounts, and what to never give.">
            Hvad der er sikkert hver dag, hvad der er fint i små mængder, og
            hvad du aldrig skal give.
        </p>
        <p data-en="Rotate a few different items from the daily list rather than feeding the same two vegetables every day — variety is what actually gets them the full spread of nutrients, not any single &quot;superfood&quot; vegetable.">
            Skift mellem et par forskellige ting fra dagslisten i stedet for
            at give de samme to grøntsager hver dag — variation er det, der
            reelt giver dem det fulde spekter af næringsstoffer, ikke én bestemt "supergrøntsag".
        </p>
    </div>
</div>

<section class="section">
    <div class="wrap guide-article">
        <div class="callout food-callout food-callout--safe">
            <h2 data-en="Safe, every day">Sikkert, hver dag</h2>
            <ul class="food-grid">
                <li><strong data-en="Hay">Hø</strong><span data-en="Unlimited, always available">Ubegrænset, altid tilgængeligt</span></li>
                <li><strong data-en="Guinea-pig-specific pellets">Marsvine-specifikt pillefoder</strong><span data-en="A measured daily portion">En afmålt daglig portion</span></li>
                <li><strong data-en="Fresh water">Frisk vand</strong><span data-en="Checked daily, not just topped up">Tjekket dagligt, ikke bare fyldt op</span></li>
                <li><strong data-en="Bell pepper">Peberfrugt</strong><span data-en="High in vitamin C, especially red and yellow">Højt C-vitaminindhold, især rød og gul</span></li>
                <li><strong data-en="Cucumber">Agurk</strong></li>
                <li><strong data-en="Romaine, rocket, lamb's lettuce">Romainesalat, rucola, feldsalat</strong></li>
                <li><strong data-en="Tomato">Tomat</strong><span data-en="Flesh only - not the stem or leaves">Kun kødet - ikke stilk eller blade</span></li>
                <li><strong data-en="Broccoli">Broccoli</strong><span data-en="Small amounts - can cause gas">Små mængder - kan give luft i maven</span></li>
                <li><strong data-en="Celery">Selleri</strong><span data-en="Cut the stringy fibres first - a choking hazard otherwise">Fjern de seje tråde først - ellers kvælningsfare</span></li>
                <li><strong data-en="Courgette / squash">Squash / courgette</strong></li>
                <li><strong data-en="Green beans">Grønne bønner</strong></li>
                <li><strong data-en="Fresh dandelion greens">Friske mælkebøtteblade</strong><span data-en="From an unsprayed patch, not the roadside">Fra et sted der ikke er sprøjtet, ikke fra vejkanten</span></li>
                <li><strong data-en="Basil">Basilikum</strong></li>
                <li><strong data-en="Coriander">Koriander</strong></li>
            </ul>
        </div>

        <div class="callout food-callout food-callout--moderate">
            <h2 data-en="Fine in small amounts, a couple of times a week">Fint i små mængder, et par gange om ugen</h2>
            <ul class="food-grid">
                <li><strong data-en="Carrot">Gulerod</strong><span data-en="High in sugar">Højt sukkerindhold</span></li>
                <li><strong data-en="Apple">Æble</strong><span data-en="No seeds - they contain trace cyanide">Uden kerner - de indeholder spor af cyanid</span></li>
                <li><strong data-en="Strawberry, banana, blueberry, raspberry">Jordbær, banan, blåbær, hindbær</strong><span data-en="High in sugar - treat-sized portions">Højt sukkerindhold - godbid-størrelse</span></li>
                <li><strong data-en="Dried dandelion">Tørret mælkebøtte</strong></li>
                <li><strong data-en="Corn">Majs</strong><span data-en="Small amounts - high in starch">Små mængder - højt stivelsesindhold</span></li>
                <li><strong data-en="Peas">Ærter</strong></li>
                <li><strong data-en="Beetroot">Rødbede</strong><span data-en="Can tint their urine red - harmless, but don't mistake it for blood">Kan farve urinen rød - harmløst, men forveksl det ikke med blod</span></li>
                <li><strong data-en="Pumpkin">Græskar</strong></li>
                <li><strong data-en="Cabbage / white cabbage">Kål / hvidkål</strong><span data-en="Can cause gas">Kan give luft i maven</span></li>
                <li><strong data-en="Spinach and kale">Spinat og grønkål</strong><span data-en="High in calcium/oxalic acid - a couple of times a week, not daily">Højt i calcium/oxalsyre - et par gange om ugen, ikke dagligt</span></li>
                <li><strong data-en="Parsley">Persille</strong><span data-en="High in oxalic acid despite the vitamin C - the same reason as spinach">Højt i oxalsyre trods C-vitaminet - samme grund som spinat</span></li>
                <li><strong data-en="Citrus (e.g. orange)">Citrusfrugt (fx appelsin)</strong><span data-en="Can irritate the mouth in larger amounts">Kan irritere munden i større mængder</span></li>
            </ul>
        </div>

        <div class="callout food-callout food-callout--never">
            <h2 data-en="Never">Aldrig</h2>
            <ul class="food-grid">
                <li><strong data-en="Iceberg lettuce">Iceberg-salat</strong><span data-en="Almost no nutrition, can cause diarrhoea">Næsten ingen næringsværdi, kan give diarré</span></li>
                <li><strong data-en="Avocado">Avocado</strong><span data-en="Toxic to guinea pigs">Giftig for marsvin</span></li>
                <li><strong data-en="Onion, garlic, leek">Løg, hvidløg, porre</strong><span data-en="The whole allium family - damages red blood cells">Hele løg-familien - skader røde blodlegemer</span></li>
                <li><strong data-en="Chocolate">Chokolade</strong><span data-en="Toxic">Giftig</span></li>
                <li><strong data-en="Dairy products">Mejeriprodukter</strong><span data-en="Adult guinea pigs are lactose intolerant">Voksne marsvin er laktoseintolerante</span></li>
                <li><strong data-en="Rhubarb">Rabarber</strong><span data-en="Toxic - high in oxalic acid">Giftig - højt indhold af oxalsyre</span></li>
                <li><strong data-en="Nuts and seeds">Nødder og frø</strong><span data-en="Choking hazard, too much fat">Kvælningsfare, for meget fedt</span></li>
                <li><strong data-en="Green potato / potato sprouts">Grønne kartofler / kartoffeltop</strong><span data-en="Contains solanine - toxic">Indeholder solanin - giftigt</span></li>
                <li><strong data-en="Bread, pasta, meat and other human food">Brød, pasta, kød og andet menneskemad</strong><span data-en="Not built for a guinea pig's gut">Ikke bygget til et marsvins fordøjelse</span></li>
            </ul>
        </div>
    </div>
</section>
